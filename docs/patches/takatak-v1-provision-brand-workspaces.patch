+/**
+ * Provision one TAKATAK workspace per brand from a PRIVATE JSON data file.
+ *
+ *   npm run provision:workspaces -- --data /outside/the/repo/group.json
+ *
+ * Dry-run by default: prints what it would create, skip or why it is
+ * blocked, and writes nothing. --apply writes through the app's own services
+ * (createClient, createBrand, createLocation) and never bypasses a plan gate.
+ * Invitations are only created and sent with --apply --send-invites.
+ *
+ * Never prints tokens, token hashes, links, keys or the connection string.
+ * Full guide: docs/WORKSPACE_PROVISIONING.md. Example data (fake):
+ * scripts/examples/provision-workspaces.example.json
+ */
+import { existsSync, readFileSync, realpathSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { getSupabaseAdminClient } from "@/lib/auth/supabase-admin";
+import { getApplicationOrigin } from "@/lib/config/app-origin";
+import { disconnectPrisma, getPrisma } from "@/lib/db/prisma";
+import {
+  buildProvisioningPlan,
+  collectDataEmails,
+  isReservedExampleEmail,
+  maskEmail,
+  parseProvisioningData,
+  PLAN_STATUSES,
+  sanitizeMessage,
+  selectBrands,
+  type PlanOptions,
+  type ProvisioningData,
+  type ProvisioningPlan,
+  type WorkspacePlan,
+} from "@/lib/provisioning/workspace-provisioning-policy";
+import {
+  applyProvisioningPlan,
+  loadProvisioningSnapshot,
+  resolveActor,
+  type InvitationAuthClient,
+  type WorkspaceApplyResult,
+} from "@/lib/provisioning/workspace-provisioning-runner";
+
+const REPO_ROOT = path.resolve(fileURLToPath(new URL("..", import.meta.url)));
+const EXAMPLE_FILE = path.join(REPO_ROOT, "scripts", "examples", "provision-workspaces.example.json");
+
+const EXIT_OK = 0;
+const EXIT_ERROR = 1;
+const EXIT_USAGE = 2;
+
+const USAGE = `Usage: npm run provision:workspaces -- --data <file> [options]
+
+  --data <file>              Private JSON data file, kept OUTSIDE this repository (required).
+  --actor-email <email>      Active Platform Owner/Admin who performs the writes (required with --apply).
+  --only <key,key>           Only these brand keys from the data file.
+  --initial-owner admin|actor
+                             Initial owner of new workspaces (default: admin = group.adminEmail).
+  --apply                    Write. Without it the run is a dry-run and writes nothing.
+  --confirm-db <hostname>    Required with --apply: must equal the DATABASE_URL hostname.
+  --send-invites             With --apply: create and send owner invitations (alias: --send-emails).
+  --invite-delay-seconds <n> Pause between two invitations (default 65).
+  --max-invites <n>          Invitations sent per run at most (default 10).
+  --reinvite-expired         Replace expired or revoked invitations.
+  --json                     Machine-readable output.
+  --show-emails              Print emails in full (masked by default).
+  --help
+
+Environment: DATABASE_URL (no database = offline validation only). For
+--send-invites also NEXT_PUBLIC_APP_URL (public https origin),
+SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL, and SUPABASE_SECRET_KEY or
+SUPABASE_SERVICE_ROLE_KEY. Load them with: npx tsx --env-file=<private file> ...
+
+Exit codes: 0 no errors (BLOCKED, DEFERRED and UNSUPPORTED are not errors),
+1 validation, precondition, conflict or write errors, 2 bad usage.`;
+
+type CliOptions = {
+  data: string;
+  actorEmail: string | null;
+  only: string[] | null;
+  initialOwner: "admin" | "actor";
+  apply: boolean;
+  confirmDb: string | null;
+  sendInvites: boolean;
+  inviteDelaySeconds: number;
+  maxInvites: number;
+  reinviteExpired: boolean;
+  json: boolean;
+  showEmails: boolean;
+};
+
+class UsageError extends Error {}
+class PreconditionError extends Error {}
+
+const VALUE_FLAGS = new Set([
+  "--data",
+  "--actor-email",
+  "--only",
+  "--initial-owner",
+  "--confirm-db",
+  "--invite-delay-seconds",
+  "--max-invites",
+]);
+const BOOLEAN_FLAGS = new Set([
+  "--apply",
+  "--send-invites",
+  "--send-emails",
+  "--reinvite-expired",
+  "--json",
+  "--show-emails",
+  "--help",
+]);
+
+function readInteger(flag: string, value: string, min: number, max: number): number {
+  if (!/^\d+$/.test(value) || Number(value) < min || Number(value) > max) {
+    throw new UsageError(`${flag} must be a whole number from ${min} to ${max}.`);
+  }
+  return Number(value);
+}
+
+function parseCliArguments(argv: string[]): CliOptions | "help" {
+  const values = new Map<string, string>();
+  const flags = new Set<string>();
+
+  for (let index = 0; index < argv.length; index += 1) {
+    const argument = argv[index];
+    const [flag, inline] = argument.includes("=")
+      ? [argument.slice(0, argument.indexOf("=")), argument.slice(argument.indexOf("=") + 1)]
+      : [argument, undefined];
+    if (VALUE_FLAGS.has(flag)) {
+      const value = inline ?? argv[index + 1];
+      if (inline === undefined) index += 1;
+      if (value === undefined || value.startsWith("--")) {
+        throw new UsageError(`${flag} needs a value.`);
+      }
+      values.set(flag, value);
+    } else if (BOOLEAN_FLAGS.has(flag) && inline === undefined) {
+      flags.add(flag);
+    } else {
+      throw new UsageError(`Unknown argument: ${flag}`);
+    }
+  }
+
+  if (flags.has("--help")) return "help";
+
+  const data = values.get("--data");
+  if (!data) throw new UsageError("--data <file> is required.");
+
+  const initialOwner = values.get("--initial-owner") ?? "admin";
+  if (initialOwner !== "admin" && initialOwner !== "actor") {
+    throw new UsageError("--initial-owner must be admin or actor.");
+  }
+
+  const options: CliOptions = {
+    data,
+    actorEmail: values.get("--actor-email")?.trim().toLowerCase() || null,
+    only: values.has("--only")
+      ? (values.get("--only") as string).split(",").map((key) => key.trim()).filter(Boolean)
+      : null,
+    initialOwner,
+    apply: flags.has("--apply"),
+    confirmDb: values.get("--confirm-db")?.trim() || null,
+    sendInvites: flags.has("--send-invites") || flags.has("--send-emails"),
+    inviteDelaySeconds: values.has("--invite-delay-seconds")
+      ? readInteger("--invite-delay-seconds", values.get("--invite-delay-seconds") as string, 0, 3600)
+      : 65,
+    maxInvites: values.has("--max-invites")
+      ? readInteger("--max-invites", values.get("--max-invites") as string, 0, 100)
+      : 10,
+    reinviteExpired: flags.has("--reinvite-expired"),
+    json: flags.has("--json"),
+    showEmails: flags.has("--show-emails"),
+  };
+
+  if (options.sendInvites && !options.apply) {
+    throw new UsageError("--send-invites only works together with --apply.");
+  }
+  if (options.apply && !options.actorEmail) {
+    throw new UsageError("--apply needs --actor-email (an active Platform Owner or Admin).");
+  }
+  if (options.apply && !options.confirmDb) {
+    throw new UsageError("--apply needs --confirm-db <hostname of DATABASE_URL>.");
+  }
+  return options;
+}
+
+// ── Data file ────────────────────────────────────────────────
+
+function isInside(child: string, parent: string): boolean {
+  const relative = path.relative(parent, child);
+  return relative === "" || (!relative.startsWith("..") && !path.isAbsolute(relative));
+}
+
+function loadData(options: CliOptions): { data: ProvisioningData; fileName: string; total: number } {
+  const resolved = path.resolve(process.cwd(), options.data);
+  if (!existsSync(resolved)) {
+    throw new PreconditionError("The --data file does not exist.");
+  }
+  const real = realpathSync(resolved);
+  const repoRoot = realpathSync(REPO_ROOT);
+  if (isInside(real, repoRoot)) {
+    const isExample = existsSync(EXAMPLE_FILE) && real === realpathSync(EXAMPLE_FILE);
+    if (!isExample || options.apply) {
+      throw new PreconditionError(
+        "Keep the data file OUTSIDE this repository: the repository is public. Only the fake example file may be read from inside it, and only in dry-run.",
+      );
+    }
+  }
+
+  let raw: unknown;
+  try {
+    raw = JSON.parse(readFileSync(real, "utf8"));
+  } catch {
+    throw new PreconditionError("The data file is not valid JSON.");
+  }
+
+  const parsed = parseProvisioningData(raw);
+  if (!parsed.ok) {
+    throw new PreconditionError(
+      `The data file has ${parsed.errors.length} problem(s):\n${parsed.errors
+        .map((line) => `  - ${sanitizeMessage(line, options.showEmails)}`)
+        .join("\n")}`,
+    );
+  }
+
+  const selected = selectBrands(parsed.data, options.only);
+  if (selected.unknownKeys.length > 0) {
+    throw new UsageError(`--only names unknown keys: ${selected.unknownKeys.join(", ")}`);
+  }
+  return {
+    data: selected.data,
+    fileName: path.basename(real),
+    total: parsed.data.brands.length,
+  };
+}
+
+// ── Environment ──────────────────────────────────────────────
+
+function isLoopbackHost(hostname: string): boolean {
+  const host = hostname.replace(/^\[|\]$/g, "").toLowerCase();
+  return host === "localhost" || host === "127.0.0.1" || host === "::1" || host === "0.0.0.0";
+}
+
+function describeDatabase(): { host: string; name: string } | null {
+  const url = process.env.DATABASE_URL?.trim();
+  if (!url) return null;
+  try {
+    const parsed = new URL(url);
+    return { host: parsed.hostname, name: decodeURIComponent(parsed.pathname.replace(/^\//, "")) || "(default)" };
+  } catch {
+    throw new PreconditionError("DATABASE_URL is not a valid URL.");
+  }
+}
+
+function resolveSender(): { origin: string; auth: InvitationAuthClient } {
+  if (!process.env.NEXT_PUBLIC_APP_URL?.trim()) {
+    throw new PreconditionError(
+      "--send-invites needs NEXT_PUBLIC_APP_URL (the public https origin of the app); otherwise links would point to localhost.",
+    );
+  }
+  const origin = getApplicationOrigin();
+  const parsed = new URL(origin);
+  if (parsed.protocol !== "https:" || isLoopbackHost(parsed.hostname)) {
+    throw new PreconditionError("--send-invites needs NEXT_PUBLIC_APP_URL to be a public https origin.");
+  }
+  const supabase = getSupabaseAdminClient();
+  if (!supabase) {
+    throw new PreconditionError(
+      "--send-invites needs the Supabase admin settings (SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL, and SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY).",
+    );
+  }
+  return { origin, auth: supabase.auth };
+}
+
+// ── Output ───────────────────────────────────────────────────
+
+type Printer = {
+  showEmails: boolean;
+  email(value: string | null | undefined): string;
+  text(value: string): string;
+};
+
+function makePrinter(showEmails: boolean): Printer {
+  return {
+    showEmails,
+    email: (value) => (value ? (showEmails ? value : maskEmail(value)) : "(none)"),
+    text: (value) => sanitizeMessage(value, showEmails),
+  };
+}
+
+const PURPOSE_LABEL = {
+  brand_owner: "brand owner",
+  group_admin: "group admin",
+  brand_owner_and_group_admin: "brand owner and group admin",
+} as const;
+
+function printableWorkspace(plan: WorkspacePlan, printer: Printer) {
+  const item = (value: { status: string; reason: string; unblock?: string; existingId?: string; gate?: string }) => ({
+    status: value.status,
+    reason: printer.text(value.reason),
+    ...(value.unblock ? { unblock: printer.text(value.unblock) } : {}),
+    ...(value.existingId ? { existingId: value.existingId } : {}),
+    ...(value.gate ? { gate: value.gate } : {}),
+  });
+  return {
+    key: plan.key,
+    gates: plan.gates,
+    workspace: { name: plan.workspace.name, initialOwner: plan.workspace.initialOwner, ...item(plan.workspace) },
+    brand: { name: plan.brand.name, ...item(plan.brand) },
+    locations: plan.locations.map((location) => ({
+      name: location.name,
+      primary: location.isPrimary,
+      address: location.address,
+      ...item(location),
+    })),
+    hours: plan.hours ? { summary: plan.hours.summary, ...item(plan.hours) } : null,
+    invitations: plan.invitations.map((invitation) => ({
+      email: printer.email(invitation.email),
+      role: invitation.role,
+      purpose: invitation.purpose,
+      ...item(invitation),
+    })),
+  };
+}
+
+function gateLine(plan: WorkspacePlan): string {
+  const gates = plan.gates;
+  if (!gates.checked) return "Social plan: not checked (no database)";
+  const subject = gates.newWorkspace ? "new workspace, no Social subscription" : gates.statusLabel;
+  return `Social plan: ${subject}${gates.planCode && !gates.newWorkspace ? ` (${gates.planCode})` : ""} · brand allowance ${gates.brandAllowance} (${gates.billableBrands} in use) · team invitations: ${gates.canInviteTeam ? "allowed" : "no"}`;
+}
+
+function printPlanText(plan: ProvisioningPlan, printer: Printer): void {
+  const width = 12;
+  const line = (kind: string, status: string, subject: string, reason: string, unblock?: string) => {
+    console.log(`  ${kind.padEnd(10)} ${status.padEnd(width)} ${subject}`);
+    console.log(`  ${"".padEnd(10)} ${"".padEnd(width)} ${printer.text(reason)}`);
+    if (unblock) console.log(`  ${"".padEnd(10)} ${"".padEnd(width)} → ${printer.text(unblock)}`);
+  };
+
+  plan.workspaces.forEach((workspace, index) => {
+    console.log("");
+    console.log(`[${index + 1}/${plan.workspaces.length}] ${workspace.workspace.name}  (${workspace.key})`);
+    console.log(`  ${gateLine(workspace)}`);
+    line("workspace", workspace.workspace.status, workspace.workspace.name, workspace.workspace.reason, workspace.workspace.unblock);
+    line("brand", workspace.brand.status, workspace.brand.name, workspace.brand.reason, workspace.brand.unblock);
+    for (const location of workspace.locations) {
+      line(
+        "location",
+        location.status,
+        `${location.name}${location.isPrimary ? " (primary)" : ""} · ${location.address}`,
+        location.reason,
+        location.unblock,
+      );
+    }
+    if (workspace.hours) {
+      line("hours", workspace.hours.status, workspace.hours.summary, workspace.hours.reason, workspace.hours.unblock);
+    }
+    if (workspace.invitations.length === 0) {
+      console.log(`  ${"invite".padEnd(10)} ${"-".padEnd(width)} no invitation needed`);
+    }
+    for (const invitation of workspace.invitations) {
+      line(
+        "invite",
+        invitation.status,
+        `${printer.email(invitation.email)} (owner, ${PURPOSE_LABEL[invitation.purpose]})`,
+        invitation.reason,
+        invitation.unblock,
+      );
+    }
+  });
+
+  console.log("");
+  console.log("Summary");
+  console.log(
+    `  ${PLAN_STATUSES.filter((status) => plan.counts[status] > 0)
+      .map((status) => `${status} ${plan.counts[status]}`)
+      .join(" · ") || "nothing"}`,
+  );
+
+  if (plan.blockedByPlan.length > 0) {
+    console.log("");
+    console.log("Blocked by the Social plan (the script never bypasses these gates)");
+    for (const row of plan.blockedByPlan) {
+      const needs =
+        row.needs === "brand_and_team"
+          ? "brand + invitations"
+          : row.needs === "brand"
+            ? "brand"
+            : "invitations";
+      console.log(`  ${row.workspaceName.padEnd(28)} now: ${row.current}; blocked: ${needs}; cheapest fix: ${row.cheapestPlan}`);
+    }
+    console.log(
+      "  Plans are bought per workspace in its Plans & billing page (Stripe Checkout). Essential holds 1 brand; team invitations need Advanced 15/25/50 or a Custom contract.",
+    );
+  }
+}
+
+function printResultsText(results: WorkspaceApplyResult[], printer: Printer): void {
+  console.log("");
+  console.log("Applied");
+  for (const result of results) {
+    if (result.items.length === 0 && result.errors.length === 0) continue;
+    console.log(`  ${result.workspaceName}${result.clientId ? `  [${result.clientId}]` : ""}`);
+    for (const item of result.items) {
+      const subject = item.kind === "invitation" ? printer.email(item.name) : item.name;
+      console.log(
+        `    ${item.outcome.padEnd(8)} ${item.kind.padEnd(10)} ${subject}${item.id ? `  [${item.id}]` : ""}${item.message ? ` · ${printer.text(item.message)}` : ""}`,
+      );
+    }
+    for (const error of result.errors) {
+      console.log(`    ERROR    ${printer.text(error)}`);
+    }
+    if (result.clientId) {
+      console.log(`    read-back ${result.verified ? "ok" : "FAILED"}`);
+    }
+  }
+}
+
+// ── Main ─────────────────────────────────────────────────────
+
+async function main(argv: string[]): Promise<number> {
+  let options: CliOptions;
+  try {
+    const parsed = parseCliArguments(argv);
+    if (parsed === "help") {
+      console.log(USAGE);
+      return EXIT_OK;
+    }
+    options = parsed;
+  } catch (error) {
+    if (error instanceof UsageError) {
+      console.error(`${error.message}\n\n${USAGE}`);
+      return EXIT_USAGE;
+    }
+    throw error;
+  }
+
+  const printer = makePrinter(options.showEmails);
+  const { data, fileName, total } = loadData(options);
+  const database = describeDatabase();
+
+  if (options.apply) {
+    if (!database) {
+      throw new PreconditionError("--apply needs DATABASE_URL.");
+    }
+    if (options.confirmDb !== database.host) {
+      throw new PreconditionError(
+        `--confirm-db does not match the DATABASE_URL hostname (${database.host}). Nothing was changed.`,
+      );
+    }
+    const reserved = collectDataEmails(data).filter(isReservedExampleEmail);
+    if (reserved.length > 0 && !isLoopbackHost(database.host)) {
+      throw new PreconditionError(
+        `The data uses ${reserved.length} example/test email address(es) (example.com, .test, ...). --apply refuses them outside a local database.`,
+      );
+    }
+  }
+
+  const planOptions: PlanOptions = {
+    initialOwner: options.initialOwner,
+    sendInvites: options.sendInvites,
+    maxInvites: options.maxInvites,
+    reinviteExpired: options.reinviteExpired,
+  };
+
+  const header = {
+    mode: !database ? "offline" : options.apply ? "apply" : "dry-run",
+    dataFile: fileName,
+    brandEntries: total,
+    selected: data.brands.length,
+    database,
+  };
+
+  if (!database) {
+    const plan = buildProvisioningPlan(data, null, planOptions);
+    if (options.json) {
+      console.log(JSON.stringify({ ...header, plan: { ...plan, workspaces: plan.workspaces.map((w) => printableWorkspace(w, printer)) } }, null, 2));
+    } else {
+      console.log("TAKATAK workspace provisioning: OFFLINE (no DATABASE_URL; data validated only, nothing written)");
+      console.log(`Data file: ${fileName} · ${total} brand entr${total === 1 ? "y" : "ies"}${options.only ? ` (${data.brands.length} selected)` : ""}`);
+      console.log(`Group admin: ${printer.email(data.group.adminEmail)}`);
+      printPlanText(plan, printer);
+      console.log("\nThe data file is valid. Set DATABASE_URL to check the database and the plan gates.");
+    }
+    return EXIT_OK;
+  }
+
+  const sender = options.sendInvites ? resolveSender() : null;
+
+  if (!getPrisma()) {
+    throw new PreconditionError("The database client could not start.");
+  }
+
+  let actor: { profileId: string; email: string } | null = null;
+  let actorRole: string | null = null;
+  if (options.actorEmail) {
+    const check = await resolveActor(options.actorEmail);
+    if (!check.ok) {
+      throw new PreconditionError(`${check.message} Nothing was changed.`);
+    }
+    actor = { profileId: check.profileId, email: check.email };
+    actorRole = check.role;
+  }
+
+  const snapshot = await loadProvisioningSnapshot(data, actor);
+  const plan = buildProvisioningPlan(data, snapshot, planOptions);
+
+  if (!options.json) {
+    console.log(
+      options.apply
+        ? "TAKATAK workspace provisioning: APPLY (writes through the app services)"
+        : "TAKATAK workspace provisioning: DRY RUN (nothing is written)",
+    );
+    console.log(`Data file: ${fileName} · ${total} brand entr${total === 1 ? "y" : "ies"}${options.only ? ` (${data.brands.length} selected)` : ""}`);
+    console.log(`Database: ${database.host} / ${database.name}`);
+    console.log(`Actor: ${actor ? `${printer.email(actor.email)} (Platform ${actorRole})` : "not given (dry-run only; ownership by the actor is not checked)"}`);
+    console.log(`Group admin: ${printer.email(data.group.adminEmail)} · active TAKATAK account: ${snapshot.admin ? "yes" : "no"}`);
+    console.log(
+      `Initial owner of new workspaces: ${options.initialOwner === "admin" ? "the group admin (owner through createClient, no invitation)" : "the actor (the group admin gets an owner invitation)"}`,
+    );
+    console.log(
+      `Invitations: ${options.sendInvites ? `sent with --send-invites, at most ${options.maxInvites}, ${options.inviteDelaySeconds}s apart` : "not created or sent in this run (needs --apply --send-invites)"}`,
+    );
+    printPlanText(plan, printer);
+  }
+
+  if (!options.apply) {
+    if (options.json) {
+      console.log(JSON.stringify({ ...header, plan: { ...plan, workspaces: plan.workspaces.map((w) => printableWorkspace(w, printer)) } }, null, 2));
+    } else {
+      console.log("\nDry-run: nothing was written. Add --apply --actor-email <you> --confirm-db <host> to write.");
+    }
+    return plan.conflicts > 0 ? EXIT_ERROR : EXIT_OK;
+  }
+
+  const results = await applyProvisioningPlan(plan, {
+    actorProfileId: (actor as { profileId: string }).profileId,
+    sender,
+    inviteDelayMs: options.inviteDelaySeconds * 1000,
+    onProgress: options.json ? undefined : (message) => console.log(`… ${printer.text(message)}`),
+  });
+
+  // Idempotency re-check: plan again from a fresh snapshot.
+  const recheck = buildProvisioningPlan(
+    data,
+    await loadProvisioningSnapshot(data, actor),
+    { ...planOptions, sendInvites: false },
+  );
+  const errors = results.reduce((sum, result) => sum + result.errors.length, 0);
+
+  if (options.json) {
+    console.log(
+      JSON.stringify(
+        {
+          ...header,
+          plan: { ...plan, workspaces: plan.workspaces.map((w) => printableWorkspace(w, printer)) },
+          results: results.map((result) => ({
+            ...result,
+            items: result.items.map((item) => ({
+              ...item,
+              name: item.kind === "invitation" ? printer.email(item.name) : item.name,
+              message: item.message ? printer.text(item.message) : undefined,
+            })),
+            errors: result.errors.map((error) => printer.text(error)),
+          })),
+          recheck: { counts: recheck.counts },
+        },
+        null,
+        2,
+      ),
+    );
+  } else {
+    printResultsText(results, printer);
+    console.log("");
+    console.log(
+      `Re-check: a second run would create ${recheck.counts.CREATE} item(s); ${recheck.counts.PLANNED} invitation(s) still planned; ${recheck.counts.BLOCKED} blocked.`,
+    );
+    console.log(errors > 0 ? `${errors} error(s).` : "No errors.");
+  }
+
+  return errors > 0 || plan.conflicts > 0 ? EXIT_ERROR : EXIT_OK;
+}
+
+main(process.argv.slice(2))
+  .then((code) => {
+    process.exitCode = code;
+  })
+  .catch((error: unknown) => {
+    const message = error instanceof Error ? error.message : "Provisioning failed.";
+    console.error(sanitizeMessage(message, process.argv.includes("--show-emails")));
+    process.exitCode = error instanceof UsageError ? EXIT_USAGE : EXIT_ERROR;
+  })
+  .finally(() => disconnectPrisma());
