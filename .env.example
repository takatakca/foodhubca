# Run `npm run setup` instead of editing this file by hand — the wizard writes .env.local
# and generates webhook secrets for you. Never commit real values or paste them in chat.

# Supabase (read when the server runs, not at build time: a Docker/Coolify image needs no build argument).
# SUPABASE_URL is accepted instead of NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Safety
LIVE_CONNECTORS_GLOBAL_ENABLED=false
# Your own https address, no trailing slash, e.g. https://foodhub.takatak.ca. Every URL Food Hub gives the platforms and
# Clover (Site URL, webhooks, legal pages) is built from it. A temporary <ip>.sslip.io address works for a first
# install, but the Clover App Market listing must use your own domain (Settings → Clover app checks it).
FOODHUB_PUBLIC_URL=
# Scheduled jobs (Vercel Cron or any scheduler) send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Sign-in (RC10): everyone signs in with a 6-digit code (or one-tap link) sent by email or SMS — no passwords.
# The first owner account can only be created with this email / cell (or with the recovery password as setup key).
FOODHUB_OWNER_EMAIL=
FOODHUB_OWNER_PHONE=
# Recovery only: sign in as "owner" with this password if email/SMS are down. Also lets scripts use Basic auth.
DASHBOARD_PASSWORD=
# Signs sessions and kitchen-tablet cookies (generated by npm run setup). Changing it signs everyone out.
# In production, when empty, it is generated once and kept in the database (like the webhook secrets).
SESSION_SECRET=
# Sign-in throttling keys on the client address from x-forwarded-for only behind a proxy that sets it: automatic on
# Vercel; set to true behind Caddy/Traefik/nginx/Cloudflare (the VPS installer does); leave empty when the app faces clients directly.
FOODHUB_TRUST_PROXY=
# NEVER in production: shows sign-in codes on screen when email/SMS could not be sent (demo / first test only).
FOODHUB_INSECURE_SHOW_CODES=false

# Email (Resend) — sign-in codes, invitations, alert summaries and reports. The From domains must be verified.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
REPORT_EMAIL_FROM=

# SMS + phone calls (Twilio) — sign-in codes by SMS, alerts by text, alert calls ("your tablet is off"), customer texts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: a Messaging Service (MG...) instead of TWILIO_FROM for SMS
TWILIO_MESSAGING_SERVICE_SID=

# Watchtower (background supervisor)
# Team chat incoming webhook: Slack, Microsoft Teams, Google Chat or Discord.
ALERT_WEBHOOK_URL=
# Claude explains each alert and powers the copilot. Without a key, built-in rules are used. AI never approves,
# refunds, posts or deletes anything — it only explains and suggests.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# On a long-running server (`next start`) the Watchtower also runs on this timer (0 = off). On Vercel, call
# /api/foodhub/cron/watch every minute instead (see docs/FOODHUB.md).
FOODHUB_WATCH_INTERVAL_S=30
AI_INGESTION_ENABLED=true
CONNECTOR_NETWORK_TIMEOUT_MS=15000

# Food Hub behaviour (defaults shown)
FOODHUB_POS_INJECTION=clover
FOODHUB_CURRENCY=CAD
FOODHUB_TIMEZONE=America/Toronto
# Platform sync inside the server every N minutes: store status, Clover orders, timed re-opens and 86s, scheduled
# publishes, reports. Coolify/Docker have no system cron: the Docker image sets 5. VPS installs use cron instead.
# 0 = off. Left commented on purpose: an empty value in a Docker env file would override the image's 5.
# FOODHUB_INTERNAL_SYNC_MIN=5
# Minimum seconds between platform status syncs triggered from the dashboard
FOODHUB_SYNC_MIN_INTERVAL_S=60
# In-kitchen / ready orders are closed automatically after this many minutes (0 = never)
FOODHUB_AUTO_COMPLETE_MIN=90
# Orders due more than this many minutes after they arrive are "scheduled": held, then printed and
# started in the kitchen at (due time − prep time)
FOODHUB_SCHEDULED_AFTER_MIN=60

# Clover POS (order injection + menu import)
CLOVER_BASE_URL=https://api.clover.com
CLOVER_MERCHANT_ID=
CLOVER_ACCESS_TOKEN=
CLOVER_MERCHANT_TOKENS=
# Clover app "TAKATAK Food Hub" (App Market): App ID + App Secret → merchants connect in one click, tokens auto-renew.
# In the Clover developer dashboard: Site URL = FOODHUB_PUBLIC_URL, Alternate Launch Path = /api/foodhub/clover-connect/callback.
CLOVER_CLIENT_ID=
CLOVER_CLIENT_SECRET=
# Authorize page; derived from CLOVER_BASE_URL (sandbox → https://sandbox.dev.clover.com) when empty
CLOVER_WEB_URL=
# A merchant that opens the app from Clover is used only if it is known (CLOVER_MERCHANT_ID, CLOVER_MERCHANT_TOKENS,
# a store mapped to it, or listed here, comma-separated). Any other merchant waits for your approval in
# Settings → Platforms & Clover — nothing is sent to it before that.
CLOVER_ALLOWED_MERCHANTS=
# Orders that DoorDash / Uber Eats create in Clover through Clover's OWN integration are read into Food Hub
# (read-only "via Clover", never counted as in-store sales). off = do not read them.
FOODHUB_CLOVER_PLATFORM_ORDERS=on
# Platforms linked to Clover DIRECTLY (Clover → Online ordering → Partners), comma-separated, e.g. doordash.
# Food Hub then reads their orders from Clover only and never calls their API (menu, 86, pauses are done in Clover).
FOODHUB_VIA_CLOVER=
# Food Hub Order Relay (/api/foodhub/webhooks/relay): partners that PUSH orders (a TGTG feed…). See docs/ORDER_RELAY.md.
# Platforms accepted on the relay (empty = tgtg) — never one that is also connected directly (orders would arrive twice).
FOODHUB_RELAY_CHANNELS=
# Token in the relay address; generated automatically when empty
FOODHUB_RELAY_SECRET=
# Where Accept / Ready / Reject are POSTed back (optional) and the Bearer token sent with them
FOODHUB_RELAY_CALLBACK_URL=
FOODHUB_RELAY_CALLBACK_TOKEN=
# Print a kitchen ticket on Clover for every delivery order (on/off) and, optionally, on which device
FOODHUB_CLOVER_AUTOPRINT=on
CLOVER_PRINT_DEVICE_ID=
# Several Clover merchants: one kitchen printer per merchant, {"MERCHANT_ID":"deviceId",...} (a device belongs to one merchant).
# One merchant for several kitchens: {"MERCHANT_ID|LOCATION_CODE":"deviceId"} sends each kitchen's tickets to its own printer.
CLOVER_PRINT_DEVICES=
# When a platform order leaves the kitchen (picked up / completed / auto-completed), record it as paid in Clover with an
# "Uber Eats" / "DoorDash" / "SkipTheDishes" / "Too Good To Go" tender, so the Clover closeout does not show it open (on/off).
# Clover payments cannot be deleted by API, so cancelled orders are removed from the register before any payment instead.
FOODHUB_CLOVER_RECORD_PAYMENT=on
FOODHUB_CLOVER_DELETE_CANCELLED=on
# Tag each order with a Clover order type (on/off): the merchant's "Online Order Delivery" / "Online Order Pick Up"
# when it has them (found by label), otherwise one type per platform ("Uber Eats", "DoorDash"…, created once).
FOODHUB_CLOVER_ORDER_TYPES=on
# platform = always one order type per platform (the behaviour before delivery / pickup types)
FOODHUB_CLOVER_ORDER_TYPE_MODE=
# Pin the order type ids instead of finding them by label: {"delivery":"…","pickup":"…"} or {"MERCHANT_ID":{…}}
CLOVER_ORDER_TYPES=
# Pickup / own-delivery tips go on the Clover payment (the restaurant's); delivery tips are the courier's (on/off)
FOODHUB_CLOVER_RECORD_TIPS=on
# Clover did not take an order: seconds before each automatic retry (then a manager is alerted); off = manual only
FOODHUB_CLOVER_RETRY_S=30,120
# Webhook inbox: seconds before each automatic re-try of a webhook that failed (then it waits for Replay)
FOODHUB_INBOX_RETRY_S=30,120
# Stores whose menu Food Hub must never change (no publish, no 86), besides Po Poulet NDG on DoorDash (built in):
# channel:storeId, comma-separated, e.g. doordash:12345678,uber_eats:<store uuid>. Also per store under Stores → Mapping.
FOODHUB_MENU_LOCKED_STORES=
# Clover item marked unavailable / out of stock → 86 on every platform, back on when Clover has it again (on/off)
FOODHUB_CLOVER_INVENTORY_SYNC=on
# Optional, Clover app webhooks: the auth code (X-Clover-Auth) shown in the Clover developer dashboard.
# Without it, Food Hub checks Clover items on every sync instead (slower, same result).
CLOVER_WEBHOOK_AUTH=

# Uber Eats direct (Marketplace APIs) — docs/UBER_EATS_FINAL.md
# Production app: leave UBER_ENV empty (auth.uber.com + api.uber.com). A "Testing" (sandbox) app: UBER_ENV=sandbox
# (sandbox-login.uber.com + test-api.uber.com — Uber refuses mixed domains). UBER_BASE_URL / UBER_AUTH_URL /
# UBER_LOGIN_URL override one host each.
UBER_ENV=
UBER_BASE_URL=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# Only if Uber integration support asks for an item tax rate (charged ON TOP of the price; Uber otherwise computes
# GST/QST from the store's own tax setup). Example: 14.975
UBER_TAX_RATE_PCT=
# Uber webhook Signing Key (Basic HMAC) — generated by npm run setup; paste it in the Uber developer dashboard → Webhooks.
UBER_WEBHOOK_SIGNING_KEY=
UBER_WEBHOOK_SIGNING_KEY_2=
UBER_OAUTH_SCOPE=eats.order eats.store eats.store.status.write
UBER_ACCESS_TOKEN=
# Uber Reporting API (payment details report → automatic payout reconciliation). Read-only.
UBER_REPORT_SCOPE=eats.report
# Report files are only downloaded from https uber.com / amazonaws.com links; add a proxy host here if yours differs (comma-separated)
UBER_REPORT_ALLOWED_HOSTS=

# DoorDash direct (Marketplace API, JWT)
DOORDASH_BASE_URL=https://openapi.doordash.com/marketplace
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
DOORDASH_PROVIDER_TYPE=
DOORDASH_WEBHOOK_SECRET=
# true once DoorDash allowlisted merchant order cancellations for your integration (offers Cancel on accepted DoorDash orders)
DOORDASH_MERCHANT_CANCEL=false

# SkipTheDishes direct — JET Connect (Just Eat Takeaway POS API). No aggregator.
SKIP_JET_BASE_URL=https://api.flytplatform.com
SKIP_JET_API_KEY=
SKIP_WEBHOOK_HMAC_SECRET=
SKIP_WEBHOOK_API_KEY=

# Too Good To Go (no public merchant API — inbound webhook only, if TGTG provides a feed)
TGTG_WEBHOOK_SECRET=
TGTG_SPEC_CONFIRMED=false
# Unit of all-integer amounts in a TGTG feed payload: true = cents (default), false = dollars. Decided once per
# payload; any amount with a fractional part anywhere means the whole payload is in dollars.
TGTG_AMOUNTS_IN_CENTS=true

# Optional/later only
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Public pages /legal/privacy, /legal/terms, /legal/support (URLs for the Clover App Market listing).
# They show a "draft" banner until FOODHUB_LEGAL_APPROVED=true (after the owner and a legal adviser review them).
# Clover requires a support email AND phone on the listing. Hours default to "Lun–ven 9 h – 17 h (HE) / Mon–Fri 9 am – 5 pm ET".
# Clover does not allow the word "Clover" in the support email domain.
FOODHUB_SUPPORT_EMAIL=
FOODHUB_SUPPORT_PHONE=
FOODHUB_SUPPORT_HOURS=
# Person responsible for the protection of personal information (Québec Law 25); default: highest authority of the company
FOODHUB_PRIVACY_OFFICER=
FOODHUB_LEGAL_COMPANY=Quadro Holdings LTEE
FOODHUB_LEGAL_ADDRESS=
FOODHUB_LEGAL_UPDATED=2026-10-07
FOODHUB_LEGAL_APPROVED=false
