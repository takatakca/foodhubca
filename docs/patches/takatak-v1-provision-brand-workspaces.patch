+/**
+ * Pure planning for `scripts/provision-workspaces.ts`.
+ *
+ * No database, no network, no secrets. This module:
+ * - parses and validates the private data file (one workspace per brand),
+ *   running every entity through the app's own validators;
+ * - turns a read-only database snapshot into a plan where every item is
+ *   CREATE, SKIP, BLOCKED, DEFERRED, CONFLICT, UNSUPPORTED, PLANNED or SEND;
+ * - evaluates the Social plan gates with the app's own pure policy functions
+ *   (the same ones `assertClientCanAddBrand` and `assertClientCanInviteTeam`
+ *   use), so a dry-run reports exactly what the services would refuse.
+ *
+ * Nothing here writes. The script performs writes through the app services.
+ */
+
+import { normalizeEmail } from "@/lib/auth/registration-validation";
+import { effectiveBrandAllowance } from "@/lib/billing/social/brand-allowance-policy";
+import {
+  evaluateTeamInvite,
+  evaluateWorkspaceWriteAccess,
+} from "@/lib/billing/social/entitlement-gates-policy";
+import { SOCIAL_PLAN_CATALOG } from "@/lib/billing/social/plan-catalog";
+import { resolveEffectiveSocialEntitlements } from "@/lib/billing/social/subscription-lifecycle";
+import {
+  validateBrandInput,
+  type BrandInput,
+} from "@/lib/brands/brand-validation";
+import {
+  validateClientCreate,
+  type ClientCreateInput,
+} from "@/lib/clients/client-validation";
+import {
+  validateLocationInput,
+  type LocationInput,
+} from "@/lib/locations/location-validation";
+import { validateInvitationInput } from "@/lib/team/invitation-validation";
+
+export const PROVISIONING_DATA_VERSION = 1;
+
+/** Valid UUID used only to run validateLocationInput before the brand exists. */
+export const PLACEHOLDER_BRAND_ID = "00000000-0000-4000-8000-000000000000";
+
+export const LOCATION_NAME_MAX = 140;
+
+/** Statuses of the app's billable brands (brand-allowance.ts). */
+const BILLABLE_BRAND_STATUSES = ["active", "draft", "paused"];
+
+const KEY_PATTERN = /^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$/;
+const TIME_PATTERN = /^([01][0-9]|2[0-3]):([0-5][0-9])$/;
+
+export const HOURS_DAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] as const;
+export type HoursDay = (typeof HOURS_DAYS)[number];
+export type WeeklyHours = Record<HoursDay, Array<[string, string]>>;
+
+/** RFC 2606 / 6761 names. A real --apply must never use them. */
+const RESERVED_EMAIL_DOMAINS = ["example.com", "example.net", "example.org"];
+const RESERVED_EMAIL_TLDS = ["example", "test", "invalid", "localhost"];
+
+// ── Data file ────────────────────────────────────────────────
+
+export type ProvisioningLocation = {
+  name: string;
+  /** Resolved: the flagged location, or the first one when none is flagged. */
+  isPrimary: boolean;
+  /**
+   * Validated with PLACEHOLDER_BRAND_ID; the real brand id is set at apply
+   * time. input.isPrimary is true only when the data flags it, so a new
+   * location never takes "primary" from an existing one by accident
+   * (createLocation already makes the first location of a brand primary).
+   */
+  input: Omit<LocationInput, "businessBrandId">;
+};
+
+export type ProvisioningHours = {
+  label: string;
+  weekly: WeeklyHours;
+  summary: string;
+};
+
+export type ProvisioningBrandEntry = {
+  key: string;
+  workspaceName: string;
+  workspaceEmail: string | null;
+  ownerEmail: string | null;
+  /** validateClientCreate output without the owner (chosen at plan time). */
+  client: Omit<ClientCreateInput, "ownerEmail">;
+  brand: BrandInput;
+  locations: ProvisioningLocation[];
+  hours: ProvisioningHours | null;
+};
+
+export type ProvisioningData = {
+  version: typeof PROVISIONING_DATA_VERSION;
+  group: {
+    companyName: string | null;
+    adminEmail: string;
+    assignedPlatformAdminEmail: string | null;
+  };
+  brands: ProvisioningBrandEntry[];
+};
+
+export type DataParseResult =
+  | { ok: true; data: ProvisioningData }
+  | { ok: false; errors: string[] };
+
+type JsonRecord = Record<string, unknown>;
+
+function isRecord(value: unknown): value is JsonRecord {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function checkKeys(
+  value: JsonRecord,
+  allowed: readonly string[],
+  path: string,
+  errors: string[],
+): void {
+  for (const key of Object.keys(value)) {
+    if (!allowed.includes(key)) {
+      errors.push(`${path}: unknown field "${key}".`);
+    }
+  }
+}
+
+function optionalString(
+  value: JsonRecord,
+  key: string,
+  path: string,
+  errors: string[],
+): string | null {
+  const raw = value[key];
+  if (raw === undefined || raw === null) {
+    return null;
+  }
+  if (typeof raw !== "string") {
+    errors.push(`${path}.${key}: must be a string or null.`);
+    return null;
+  }
+  const trimmed = raw.trim();
+  return trimmed ? trimmed : null;
+}
+
+function optionalNumber(
+  value: JsonRecord,
+  key: string,
+  path: string,
+  errors: string[],
+): number | null {
+  const raw = value[key];
+  if (raw === undefined || raw === null) {
+    return null;
+  }
+  if (typeof raw !== "number" || !Number.isFinite(raw)) {
+    errors.push(`${path}.${key}: must be a number or null.`);
+    return null;
+  }
+  return raw;
+}
+
+function optionalEmail(
+  value: JsonRecord,
+  key: string,
+  path: string,
+  errors: string[],
+): string | null {
+  const raw = optionalString(value, key, path, errors);
+  if (!raw) {
+    return null;
+  }
+  const result = validateInvitationInput({ email: raw, role: "owner" });
+  if (!result.success) {
+    errors.push(`${path}.${key}: ${result.error}`);
+    return null;
+  }
+  return result.data.email;
+}
+
+function fieldErrorLines(
+  path: string,
+  message: string,
+  fieldErrors: Record<string, string> | undefined,
+): string[] {
+  const entries = Object.entries(fieldErrors ?? {});
+  if (entries.length === 0) {
+    return [`${path}: ${message}`];
+  }
+  return entries.map(([field, text]) => `${path}.${field}: ${text}`);
+}
+
+function failureLines(
+  path: string,
+  failure: { message: string; fieldErrors: Record<string, string> },
+): string[] {
+  return fieldErrorLines(path, failure.message, failure.fieldErrors);
+}
+
+export function parseHours(
+  raw: unknown,
+  path: string,
+  errors: string[],
+): WeeklyHours | null {
+  if (!isRecord(raw)) {
+    errors.push(`${path}: must be an object with days mon..sun.`);
+    return null;
+  }
+  checkKeys(raw, HOURS_DAYS, path, errors);
+  const weekly = {} as WeeklyHours;
+  let valid = true;
+  for (const day of HOURS_DAYS) {
+    const intervals = raw[day];
+    weekly[day] = [];
+    if (intervals === undefined || intervals === null) {
+      continue;
+    }
+    if (!Array.isArray(intervals)) {
+      errors.push(`${path}.${day}: must be a list of ["HH:MM","HH:MM"] pairs.`);
+      valid = false;
+      continue;
+    }
+    intervals.forEach((pair: unknown, index) => {
+      if (
+        !Array.isArray(pair) ||
+        pair.length !== 2 ||
+        typeof pair[0] !== "string" ||
+        typeof pair[1] !== "string" ||
+        !TIME_PATTERN.test(pair[0]) ||
+        !TIME_PATTERN.test(pair[1]) ||
+        pair[0] === pair[1]
+      ) {
+        errors.push(
+          `${path}.${day}[${index}]: must be ["HH:MM","HH:MM"] with two different 24-hour times (a close before the open means past midnight).`,
+        );
+        valid = false;
+        return;
+      }
+      weekly[day].push([pair[0], pair[1]]);
+    });
+  }
+  return valid ? weekly : null;
+}
+
+function dayText(intervals: Array<[string, string]>): string {
+  return intervals.length === 0
+    ? "closed"
+    : intervals.map(([open, close]) => `${open}-${close}`).join(", ");
+}
+
+export function summarizeHours(weekly: WeeklyHours): string {
+  const texts = HOURS_DAYS.map((day) => dayText(weekly[day]));
+  if (texts.every((text) => text === texts[0])) {
+    return `every day ${texts[0]}`;
+  }
+  return HOURS_DAYS.map((day, index) => `${day} ${texts[index]}`).join("; ");
+}
+
+// ── Address matching ─────────────────────────────────────────
+
+const ADDRESS_TOKEN_ALIASES: Record<string, string> = {
+  avenue: "av",
+  ave: "av",
+  boulevard: "boul",
+  blvd: "boul",
+  bd: "boul",
+  street: "st",
+  saint: "st",
+  sainte: "ste",
+  est: "e",
+  east: "e",
+  ouest: "w",
+  west: "w",
+  o: "w",
+};
+
+/**
+ * Lowercase, strip accents and punctuation, collapse spaces, and fold common
+ * street words ("Avenue"/"Ave"/"Av", "Est"/"E"). Used only to recognise an
+ * existing location at the same address.
+ */
+export function normalizeAddressPart(value: string | null | undefined): string {
+  if (!value) {
+    return "";
+  }
+  return value
+    .normalize("NFKD")
+    .replace(/[̀-ͯ]/g, "")
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, " ")
+    .trim()
+    .split(" ")
+    .filter(Boolean)
+    .map((token) => ADDRESS_TOKEN_ALIASES[token] ?? token)
+    .join(" ");
+}
+
+export function normalizePostalCode(value: string | null | undefined): string {
+  return (value ?? "").toLowerCase().replace(/[^a-z0-9]/g, "");
+}
+
+export type AddressLike = {
+  addressLine1: string | null;
+  addressLine2: string | null;
+  city: string | null;
+  postalCode: string | null;
+};
+
+/** Same street line(s) and city; postal codes must match when both are set. */
+export function isSameAddress(a: AddressLike, b: AddressLike): boolean {
+  if (normalizeAddressPart(a.addressLine1) !== normalizeAddressPart(b.addressLine1)) {
+    return false;
+  }
+  if (normalizeAddressPart(a.addressLine2) !== normalizeAddressPart(b.addressLine2)) {
+    return false;
+  }
+  if (normalizeAddressPart(a.city) !== normalizeAddressPart(b.city)) {
+    return false;
+  }
+  const postalA = normalizePostalCode(a.postalCode);
+  const postalB = normalizePostalCode(b.postalCode);
+  return !postalA || !postalB || postalA === postalB;
+}
+
+export function formatAddress(address: AddressLike): string {
+  return [address.addressLine1, address.addressLine2, address.city, address.postalCode]
+    .filter((part) => Boolean(part && part.trim()))
+    .join(", ");
+}
+
+export function defaultLocationName(brandName: string, addressLine1: string): string {
+  return `${brandName} - ${addressLine1}`.slice(0, LOCATION_NAME_MAX).trim();
+}
+
+// ── Emails ───────────────────────────────────────────────────
+
+export function isReservedExampleEmail(email: string): boolean {
+  const domain = email.slice(email.lastIndexOf("@") + 1).toLowerCase();
+  if (
+    RESERVED_EMAIL_DOMAINS.some(
+      (reserved) => domain === reserved || domain.endsWith(`.${reserved}`),
+    )
+  ) {
+    return true;
+  }
+  const tld = domain.slice(domain.lastIndexOf(".") + 1);
+  return RESERVED_EMAIL_TLDS.includes(tld);
+}
+
+export function collectDataEmails(data: ProvisioningData): string[] {
+  const emails = new Set<string>([data.group.adminEmail]);
+  if (data.group.assignedPlatformAdminEmail) {
+    emails.add(data.group.assignedPlatformAdminEmail);
+  }
+  for (const entry of data.brands) {
+    if (entry.ownerEmail) emails.add(entry.ownerEmail);
+    if (entry.workspaceEmail) emails.add(entry.workspaceEmail);
+  }
+  return [...emails];
+}
+
+/** "person@domain.com" → "p***@domain.com". */
+export function maskEmail(email: string): string {
+  const at = email.lastIndexOf("@");
+  if (at <= 0) {
+    return "***";
+  }
+  return `${email[0]}***${email.slice(at)}`;
+}
+
+/**
+ * Makes a message safe to print: masks emails (unless showEmails), and drops
+ * URLs, connection strings, JWT-like strings and long hex/base64 runs, so a
+ * token, token hash or link can never reach the terminal.
+ */
+export function sanitizeMessage(message: string, showEmails = false): string {
+  return message
+    .replace(/[a-z][a-z0-9+.-]*:\/\/\S+/gi, "[url]")
+    .replace(/eyJ[A-Za-z0-9_-]{10,}(?:\.[A-Za-z0-9_-]+)*/g, "[redacted]")
+    .replace(/\b[a-f0-9]{24,}\b/gi, "[redacted]")
+    .replace(/[A-Za-z0-9+/_-]{40,}={0,2}/g, "[redacted]")
+    .replace(/[^\s@<>()"',;:]+@[^\s@<>()"',;:]+\.[a-z]{2,}/gi, (email) =>
+      showEmails ? email : maskEmail(email),
+    );
+}
+
+// ── Parse ────────────────────────────────────────────────────
+
+const TOP_KEYS = ["version", "group", "defaults", "addresses", "hours", "brands", "$comment"] as const;
+const GROUP_KEYS = ["companyName", "adminEmail", "assignedPlatformAdminEmail"] as const;
+const DEFAULT_KEYS = [
+  "timezone",
+  "country",
+  "region",
+  "city",
+  "brandStatus",
+  "locationStatus",
+  "category",
+] as const;
+const ADDRESS_KEYS = [
+  "addressLine1",
+  "addressLine2",
+  "city",
+  "region",
+  "postalCode",
+  "country",
+  "latitude",
+  "longitude",
+] as const;
+const BRAND_ENTRY_KEYS = [
+  "key",
+  "workspaceName",
+  "workspaceEmail",
+  "ownerEmail",
+  "brand",
+  "locations",
+  "hours",
+  "timezone",
+  "$comment",
+] as const;
+const BRAND_KEYS = ["name", "legalName", "category", "website", "phone"] as const;
+const LOCATION_KEYS = [
+  "address",
+  ...ADDRESS_KEYS,
+  "name",
+  "isPrimary",
+  "phone",
+  "website",
+] as const;
+
+const CREATABLE_STATUSES = ["active", "draft"] as const;
+
+type Defaults = {
+  timezone: string;
+  country: string;
+  region: string | null;
+  city: string | null;
+  brandStatus: string;
+  locationStatus: string;
+  category: string | null;
+};
+
+type RawAddress = {
+  addressLine1: string | null;
+  addressLine2: string | null;
+  city: string | null;
+  region: string | null;
+  postalCode: string | null;
+  country: string | null;
+  latitude: number | null;
+  longitude: number | null;
+};
+
+function readAddress(value: JsonRecord, path: string, errors: string[]): RawAddress {
+  return {
+    addressLine1: optionalString(value, "addressLine1", path, errors),
+    addressLine2: optionalString(value, "addressLine2", path, errors),
+    city: optionalString(value, "city", path, errors),
+    region: optionalString(value, "region", path, errors),
+    postalCode: optionalString(value, "postalCode", path, errors),
+    country: optionalString(value, "country", path, errors),
+    latitude: optionalNumber(value, "latitude", path, errors),
+    longitude: optionalNumber(value, "longitude", path, errors),
+  };
+}
+
+function readDefaults(raw: unknown, errors: string[]): Defaults {
+  const defaults: Defaults = {
+    timezone: "America/Toronto",
+    country: "Canada",
+    region: null,
+    city: null,
+    brandStatus: "active",
+    locationStatus: "active",
+    category: null,
+  };
+  if (raw === undefined || raw === null) {
+    return defaults;
+  }
+  if (!isRecord(raw)) {
+    errors.push("defaults: must be an object.");
+    return defaults;
+  }
+  checkKeys(raw, DEFAULT_KEYS, "defaults", errors);
+  defaults.timezone = optionalString(raw, "timezone", "defaults", errors) ?? defaults.timezone;
+  defaults.country = optionalString(raw, "country", "defaults", errors) ?? defaults.country;
+  defaults.region = optionalString(raw, "region", "defaults", errors);
+  defaults.city = optionalString(raw, "city", "defaults", errors);
+  defaults.category = optionalString(raw, "category", "defaults", errors);
+  for (const key of ["brandStatus", "locationStatus"] as const) {
+    const status = optionalString(raw, key, "defaults", errors);
+    if (status === null) continue;
+    if (!(CREATABLE_STATUSES as readonly string[]).includes(status)) {
+      errors.push(`defaults.${key}: must be "active" or "draft".`);
+      continue;
+    }
+    defaults[key] = status;
+  }
+  return defaults;
+}
+
+/**
+ * Parses the version-1 data file. Every workspace, brand, location and email
+ * goes through the app's own validators. Returns every problem at once.
+ */
+export function parseProvisioningData(raw: unknown): DataParseResult {
+  const errors: string[] = [];
+
+  if (!isRecord(raw)) {
+    return { ok: false, errors: ["The data file must contain a JSON object."] };
+  }
+  checkKeys(raw, TOP_KEYS, "data", errors);
+
+  if (raw.version !== PROVISIONING_DATA_VERSION) {
+    errors.push(`version: must be ${PROVISIONING_DATA_VERSION}.`);
+  }
+
+  // Group
+  let adminEmail = "";
+  let companyName: string | null = null;
+  let assignedPlatformAdminEmail: string | null = null;
+  if (!isRecord(raw.group)) {
+    errors.push("group: required object with companyName and adminEmail.");
+  } else {
+    checkKeys(raw.group, GROUP_KEYS, "group", errors);
+    companyName = optionalString(raw.group, "companyName", "group", errors);
+    if (companyName && companyName.length > 160) {
+      errors.push("group.companyName: at most 160 characters.");
+    }
+    adminEmail = optionalEmail(raw.group, "adminEmail", "group", errors) ?? "";
+    if (!adminEmail && !errors.some((line) => line.startsWith("group.adminEmail"))) {
+      errors.push("group.adminEmail: required.");
+    }
+    assignedPlatformAdminEmail = optionalEmail(
+      raw.group,
+      "assignedPlatformAdminEmail",
+      "group",
+      errors,
+    );
+  }
+
+  const defaults = readDefaults(raw.defaults, errors);
+
+  // Shared addresses
+  const addresses = new Map<string, RawAddress>();
+  if (raw.addresses !== undefined && raw.addresses !== null) {
+    if (!isRecord(raw.addresses)) {
+      errors.push("addresses: must be an object of named addresses.");
+    } else {
+      for (const [name, value] of Object.entries(raw.addresses)) {
+        const path = `addresses.${name}`;
+        if (!KEY_PATTERN.test(name)) {
+          errors.push(`${path}: names use a-z, 0-9 and "-".`);
+        }
+        if (!isRecord(value)) {
+          errors.push(`${path}: must be an object.`);
+          continue;
+        }
+        checkKeys(value, ADDRESS_KEYS, path, errors);
+        addresses.set(name, readAddress(value, path, errors));
+      }
+    }
+  }
+
+  // Shared hours
+  const sharedHours = new Map<string, WeeklyHours>();
+  if (raw.hours !== undefined && raw.hours !== null) {
+    if (!isRecord(raw.hours)) {
+      errors.push("hours: must be an object of named weekly schedules.");
+    } else {
+      for (const [name, value] of Object.entries(raw.hours)) {
+        const weekly = parseHours(value, `hours.${name}`, errors);
+        if (weekly) sharedHours.set(name, weekly);
+      }
+    }
+  }
+
+  // Brands
+  const brands: ProvisioningBrandEntry[] = [];
+  if (!Array.isArray(raw.brands) || raw.brands.length === 0) {
+    errors.push("brands: must be a non-empty list.");
+  } else {
+    const seenKeys = new Set<string>();
+    const seenWorkspaceNames = new Set<string>();
+
+    raw.brands.forEach((value: unknown, index) => {
+      const label =
+        isRecord(value) && typeof value.key === "string" ? ` (${value.key})` : "";
+      const path = `brands[${index}]${label}`;
+      if (!isRecord(value)) {
+        errors.push(`${path}: must be an object.`);
+        return;
+      }
+      checkKeys(value, BRAND_ENTRY_KEYS, path, errors);
+
+      const key = typeof value.key === "string" ? value.key : "";
+      if (!KEY_PATTERN.test(key)) {
+        errors.push(`${path}.key: required; use a-z, 0-9 and "-".`);
+      } else if (seenKeys.has(key)) {
+        errors.push(`${path}.key: duplicate key.`);
+      }
+      seenKeys.add(key);
+
+      if (!isRecord(value.brand)) {
+        errors.push(`${path}.brand: required object with at least a name.`);
+        return;
+      }
+      checkKeys(value.brand, BRAND_KEYS, `${path}.brand`, errors);
+      const brandName = optionalString(value.brand, "name", `${path}.brand`, errors) ?? "";
+      const workspaceName =
+        optionalString(value, "workspaceName", path, errors) ?? brandName;
+      const workspaceKey = workspaceName.toLowerCase();
+      if (workspaceName && seenWorkspaceNames.has(workspaceKey)) {
+        errors.push(`${path}.workspaceName: two entries use the same workspace name.`);
+      }
+      seenWorkspaceNames.add(workspaceKey);
+
+      const workspaceEmail = optionalEmail(value, "workspaceEmail", path, errors);
+      const ownerEmail = optionalEmail(value, "ownerEmail", path, errors);
+      const timezone = optionalString(value, "timezone", path, errors) ?? defaults.timezone;
+
+      // Workspace (Client) through the app validator. The initial owner is
+      // decided at plan time; the admin email stands in for validation.
+      const clientResult = validateClientCreate({
+        name: workspaceName,
+        companyName,
+        email: workspaceEmail,
+        phone: null,
+        planName: null,
+        timezone,
+        status: "active",
+        ownerEmail: adminEmail || "owner@placeholder.invalid",
+        assignedAdminEmail: assignedPlatformAdminEmail,
+      });
+      if (!clientResult.success) {
+        errors.push(...failureLines(`${path} workspace`, clientResult));
+      }
+
+      // Locations
+      const rawLocations = Array.isArray(value.locations) ? value.locations : null;
+      if (!rawLocations || rawLocations.length === 0) {
+        errors.push(`${path}.locations: at least one location is required.`);
+      }
+      const locations: ProvisioningLocation[] = [];
+      const primaryCount = (rawLocations ?? []).filter(
+        (location: unknown) => isRecord(location) && location.isPrimary === true,
+      ).length;
+      if (primaryCount > 1) {
+        errors.push(`${path}.locations: at most one location can have isPrimary true.`);
+      }
+
+      (rawLocations ?? []).forEach((rawLocation: unknown, locationIndex) => {
+        const locationPath = `${path}.locations[${locationIndex}]`;
+        if (!isRecord(rawLocation)) {
+          errors.push(`${locationPath}: must be an object.`);
+          return;
+        }
+        checkKeys(rawLocation, LOCATION_KEYS, locationPath, errors);
+
+        const reference = optionalString(rawLocation, "address", locationPath, errors);
+        const inline = readAddress(rawLocation, locationPath, errors);
+        let address: RawAddress;
+        if (reference) {
+          if (inline.addressLine1) {
+            errors.push(`${locationPath}: use either "address" or inline address fields, not both.`);
+          }
+          const shared = addresses.get(reference);
+          if (!shared) {
+            errors.push(`${locationPath}.address: "${reference}" is not in "addresses".`);
+            return;
+          }
+          address = shared;
+        } else {
+          address = inline;
+        }
+
+        const isPrimary =
+          rawLocation.isPrimary === true || (primaryCount === 0 && locationIndex === 0);
+        if (rawLocation.isPrimary !== undefined && typeof rawLocation.isPrimary !== "boolean") {
+          errors.push(`${locationPath}.isPrimary: must be true or false.`);
+        }
+        const name =
+          optionalString(rawLocation, "name", locationPath, errors) ??
+          defaultLocationName(brandName, address.addressLine1 ?? "");
+
+        const locationResult = validateLocationInput({
+          businessBrandId: PLACEHOLDER_BRAND_ID,
+          name,
+          phone: optionalString(rawLocation, "phone", locationPath, errors),
+          website: optionalString(rawLocation, "website", locationPath, errors),
+          addressLine1: address.addressLine1,
+          addressLine2: address.addressLine2,
+          city: address.city ?? defaults.city,
+          region: address.region ?? defaults.region,
+          postalCode: address.postalCode,
+          country: address.country ?? defaults.country,
+          timezone,
+          latitude: address.latitude,
+          longitude: address.longitude,
+          isPrimary: rawLocation.isPrimary === true,
+          status: defaults.locationStatus,
+        });
+        if (!locationResult.success) {
+          errors.push(...failureLines(locationPath, locationResult));
+          return;
+        }
+        const { businessBrandId: _placeholder, ...input } = locationResult.data;
+
+        const duplicate = locations.find(
+          (other) =>
+            other.name.toLowerCase() === input.name.toLowerCase() ||
+            isSameAddress(other.input, input),
+        );
+        if (duplicate) {
+          errors.push(`${locationPath}: same name or address as another location of this brand.`);
+          return;
+        }
+        locations.push({ name: input.name, isPrimary, input });
+      });
+
+      // Brand through the app validator. Its address is the primary location's.
+      const primary = locations.find((location) => location.isPrimary) ?? locations[0];
+      const brandResult = validateBrandInput({
+        name: brandName,
+        legalName: optionalString(value.brand, "legalName", `${path}.brand`, errors),
+        category:
+          optionalString(value.brand, "category", `${path}.brand`, errors) ?? defaults.category,
+        website: optionalString(value.brand, "website", `${path}.brand`, errors),
+        phone: optionalString(value.brand, "phone", `${path}.brand`, errors),
+        addressLine1: primary?.input.addressLine1 ?? null,
+        addressLine2: primary?.input.addressLine2 ?? null,
+        city: primary?.input.city ?? defaults.city,
+        region: primary?.input.region ?? defaults.region,
+        postalCode: primary?.input.postalCode ?? null,
+        country: primary?.input.country ?? defaults.country,
+        timezone,
+        status: defaults.brandStatus,
+      });
+      if (!brandResult.success) {
+        errors.push(...failureLines(`${path}.brand`, brandResult));
+      }
+
+      // Hours: validated and reported; the schema has no place to store them.
+      let hours: ProvisioningHours | null = null;
+      if (typeof value.hours === "string") {
+        const weekly = sharedHours.get(value.hours);
+        if (!weekly) {
+          errors.push(`${path}.hours: "${value.hours}" is not in "hours".`);
+        } else {
+          hours = { label: value.hours, weekly, summary: summarizeHours(weekly) };
+        }
+      } else if (value.hours !== undefined && value.hours !== null) {
+        const weekly = parseHours(value.hours, `${path}.hours`, errors);
+        if (weekly) {
+          hours = { label: "inline", weekly, summary: summarizeHours(weekly) };
+        }
+      }
+
+      if (clientResult.success && brandResult.success) {
+        const { ownerEmail: _owner, ...client } = clientResult.data;
+        brands.push({
+          key,
+          workspaceName: clientResult.data.name,
+          workspaceEmail: clientResult.data.email,
+          ownerEmail,
+          client,
+          brand: brandResult.data,
+          locations,
+          hours,
+        });
+      }
+    });
+  }
+
+  if (errors.length > 0) {
+    return { ok: false, errors };
+  }
+
+  return {
+    ok: true,
+    data: {
+      version: PROVISIONING_DATA_VERSION,
+      group: { companyName, adminEmail, assignedPlatformAdminEmail },
+      brands,
+    },
+  };
+}
+
+// ── Snapshot (read-only facts loaded by the script) ──────────
+
+export type SubscriptionSnapshot = {
+  status: string | null;
+  planCode: string | null;
+  cancelAtPeriodEnd: boolean;
+  currentPeriodEnd: Date | string | null;
+  xAccountAllowance: number;
+  advancedAnalytics: boolean;
+};
+
+export type ExistingLocationSnapshot = AddressLike & {
+  id: string;
+  name: string;
+  status: string;
+  isPrimary: boolean;
+};
+
+export type ExistingClientSnapshot = {
+  id: string;
+  name: string;
+  status: string;
+  ownedByAdmin: boolean;
+  ownedByActor: boolean;
+  subscription: SubscriptionSnapshot | null;
+  brands: Array<{ id: string; name: string; status: string }>;
+  /** Locations of the brands whose name matches the data (by brand id). */
+  locationsByBrandId: Record<string, ExistingLocationSnapshot[]>;
+  /** Memberships (any status) of the data's emails, keyed by normalized email. */
+  membersByEmail: Record<string, { role: string; status: string }>;
+  /** UserInvitation rows of the data's emails, keyed by normalized email. */
+  invitationsByEmail: Record<
+    string,
+    { id: string; status: string; role: string; expiresAt: Date | string }
+  >;
+};
+
+export type ProvisioningSnapshot = {
+  now: Date;
+  actor: { profileId: string; email: string } | null;
+  /** Active Profile for group.adminEmail, or null when the admin has no active account. */
+  admin: { profileId: string; email: string } | null;
+  /** null when group.assignedPlatformAdminEmail is not set. */
+  assignedAdminFound: boolean | null;
+  /** Workspaces whose name matches each entry (case-insensitive), by entry key. */
+  clientsByKey: Record<string, ExistingClientSnapshot[]>;
+  /** True when entry.workspaceEmail is already used by another workspace. */
+  workspaceEmailTakenByKey: Record<string, boolean>;
+  /** Pending, unexpired invitations of the data's emails, in any workspace. */
+  livePendingInvitations: Array<{ clientId: string; email: string }>;
+};
+
+// ── Plan ─────────────────────────────────────────────────────
+
+export type PlanStatus =
+  | "CREATE"
+  | "SKIP"
+  | "BLOCKED"
+  | "DEFERRED"
+  | "CONFLICT"
+  | "UNSUPPORTED"
+  | "PLANNED"
+  | "SEND"
+  | "UNCHECKED";
+
+export const PLAN_STATUSES: readonly PlanStatus[] = [
+  "CREATE",
+  "SKIP",
+  "BLOCKED",
+  "DEFERRED",
+  "CONFLICT",
+  "UNSUPPORTED",
+  "PLANNED",
+  "SEND",
+  "UNCHECKED",
+];
+
+type BasePlanItem = {
+  status: PlanStatus;
+  reason: string;
+  unblock?: string;
+  existingId?: string;
+  /** Set when a Social plan gate is the cause of BLOCKED. */
+  gate?: "brand" | "team";
+};
+
+export type WorkspacePlanItem = BasePlanItem & {
+  kind: "workspace";
+  name: string;
+  initialOwner: "admin" | "actor";
+  input: ClientCreateInput | null;
+};
+
+export type BrandPlanItem = BasePlanItem & {
+  kind: "brand";
+  name: string;
+  input: BrandInput;
+};
+
+export type LocationPlanItem = BasePlanItem & {
+  kind: "location";
+  name: string;
+  isPrimary: boolean;
+  address: string;
+  input: Omit<LocationInput, "businessBrandId">;
+};
+
+export type HoursPlanItem = BasePlanItem & {
+  kind: "hours";
+  summary: string;
+};
+
+export type InvitationPlanItem = BasePlanItem & {
+  kind: "invitation";
+  email: string;
+  role: "owner";
+  purpose: "brand_owner" | "group_admin" | "brand_owner_and_group_admin";
+};
+
+export type GateSummary = {
+  checked: boolean;
+  newWorkspace: boolean;
+  access: "paid" | "blocked" | "unknown";
+  statusLabel: string;
+  planCode: string | null;
+  brandAllowance: number | null;
+  billableBrands: number | null;
+  canAddBrand: boolean | null;
+  canInviteTeam: boolean | null;
+  inviteMessage: string | null;
+};
+
+export type WorkspacePlan = {
+  key: string;
+  workspace: WorkspacePlanItem;
+  brand: BrandPlanItem;
+  locations: LocationPlanItem[];
+  hours: HoursPlanItem | null;
+  invitations: InvitationPlanItem[];
+  gates: GateSummary;
+};
+
+export type BlockedByPlanRow = {
+  key: string;
+  workspaceName: string;
+  current: string;
+  needs: "brand" | "brand_and_team" | "team";
+  cheapestPlan: string;
+};
+
+export type ProvisioningPlan = {
+  mode: "offline" | "database";
+  workspaces: WorkspacePlan[];
+  counts: Record<PlanStatus, number>;
+  blockedByPlan: BlockedByPlanRow[];
+  conflicts: number;
+};
+
+export type PlanOptions = {
+  initialOwner: "admin" | "actor";
+  sendInvites: boolean;
+  maxInvites: number;
+  reinviteExpired: boolean;
+};
+
+export const BRAND_UNBLOCK_HINT =
+  "Subscribe this workspace to Social Essential (1 brand) or higher in its Plans & billing page, then re-run.";
+export const TEAM_UNBLOCK_HINT =
+  "Team invitations need Advanced 15, 25 or 50 (or a Custom contract) on this workspace, then re-run. Until then the group admin, who already owns the workspace, can run it alone.";
+
+function cadMonthly(planCode: keyof typeof SOCIAL_PLAN_CATALOG): string {
+  const entry = SOCIAL_PLAN_CATALOG[planCode];
+  return `${entry.planName} (${entry.displayMonthlyCad.toFixed(2)} CAD/month before tax)`;
+}
+
+function sameEmail(a: string | null | undefined, b: string | null | undefined): boolean {
+  return Boolean(a && b && normalizeEmail(a) === normalizeEmail(b));
+}
+
+export function evaluateGates(
+  subscription: SubscriptionSnapshot | null,
+  billableBrands: number,
+  now: Date,
+  newWorkspace: boolean,
+): GateSummary {
+  const { lifecycle, entitlements, effectivePlanCode } = resolveEffectiveSocialEntitlements({
+    status: subscription?.status,
+    planCode: subscription?.planCode,
+    cancelAtPeriodEnd: subscription?.cancelAtPeriodEnd,
+    currentPeriodEnd: subscription?.currentPeriodEnd,
+    addOns: {
+      xAccountAllowance: subscription?.xAccountAllowance ?? 0,
+      advancedAnalytics: subscription?.advancedAnalytics ?? false,
+    },
+    now,
+  });
+  const allowance = effectiveBrandAllowance(
+    lifecycle.access,
+    entitlements.brandAllowance,
+    lifecycle.displayKey,
+  );
+  const write = evaluateWorkspaceWriteAccess(lifecycle.access);
+  const invite = write.allowed ? evaluateTeamInvite(entitlements) : write;
+
+  return {
+    checked: true,
+    newWorkspace,
+    access: lifecycle.access,
+    statusLabel: lifecycle.label,
+    planCode: lifecycle.access === "paid" ? effectivePlanCode : subscription?.planCode ?? null,
+    brandAllowance: allowance,
+    billableBrands,
+    canAddBrand: billableBrands < allowance,
+    canInviteTeam: invite.allowed,
+    inviteMessage: invite.allowed ? null : invite.message,
+  };
+}
+
+function uncheckedGates(): GateSummary {
+  return {
+    checked: false,
+    newWorkspace: false,
+    access: "unknown",
+    statusLabel: "not checked (no database)",
+    planCode: null,
+    brandAllowance: null,
+    billableBrands: null,
+    canAddBrand: null,
+    canInviteTeam: null,
+    inviteMessage: null,
+  };
+}
+
+function brandGateReason(gates: GateSummary): string {
+  if (gates.brandAllowance === 0) {
+    return `Social access is locked (${gates.statusLabel}), so the workspace's brand allowance is 0. The app's createBrand would refuse.`;
+  }
+  return `The plan allows ${gates.brandAllowance} brand(s) and the workspace already has ${gates.billableBrands}.`;
+}
+
+type Invitee = {
+  email: string;
+  purpose: InvitationPlanItem["purpose"];
+};
+
+function inviteesFor(
+  entry: ProvisioningBrandEntry,
+  data: ProvisioningData,
+  inviteAdmin: boolean,
+): Invitee[] {
+  const invitees: Invitee[] = [];
+  if (entry.ownerEmail) {
+    invitees.push({ email: entry.ownerEmail, purpose: "brand_owner" });
+  }
+  if (inviteAdmin) {
+    const existing = invitees.find((invitee) => sameEmail(invitee.email, data.group.adminEmail));
+    if (existing) {
+      existing.purpose = "brand_owner_and_group_admin";
+    } else {
+      invitees.push({ email: data.group.adminEmail, purpose: "group_admin" });
+    }
+  }
+  return invitees;
+}
+
+function offlineWorkspacePlan(
+  entry: ProvisioningBrandEntry,
+  data: ProvisioningData,
+  options: PlanOptions,
+): WorkspacePlan {
+  const reason = "Not checked (no database).";
+  return {
+    key: entry.key,
+    workspace: {
+      kind: "workspace",
+      name: entry.workspaceName,
+      initialOwner: options.initialOwner,
+      input: null,
+      status: "UNCHECKED",
+      reason,
+    },
+    brand: { kind: "brand", name: entry.brand.name, input: entry.brand, status: "UNCHECKED", reason },
+    locations: entry.locations.map((location) => ({
+      kind: "location",
+      name: location.name,
+      isPrimary: location.isPrimary,
+      address: formatAddress(location.input),
+      input: location.input,
+      status: "UNCHECKED",
+      reason,
+    })),
+    hours: hoursItem(entry),
+    invitations: inviteesFor(entry, data, options.initialOwner === "actor").map((invitee) => ({
+      kind: "invitation",
+      email: invitee.email,
+      role: "owner",
+      purpose: invitee.purpose,
+      status: "UNCHECKED",
+      reason,
+    })),
+    gates: uncheckedGates(),
+  };
+}
+
+function hoursItem(entry: ProvisioningBrandEntry): HoursPlanItem | null {
+  if (!entry.hours) {
+    return null;
+  }
+  return {
+    kind: "hours",
+    summary: entry.hours.summary,
+    status: "UNSUPPORTED",
+    reason:
+      "The database has no opening-hours field (BusinessBrand and BusinessLocation have none), so the hours are validated but not stored.",
+    unblock: "Storing hours needs a schema change in its own pull request (owner decision).",
+  };
+}
+
+type RunState = {
+  plannedEmails: Set<string>;
+  plannedCount: number;
+};
+
+function planWorkspace(
+  entry: ProvisioningBrandEntry,
+  data: ProvisioningData,
+  snapshot: ProvisioningSnapshot,
+  options: PlanOptions,
+  run: RunState,
+): WorkspacePlan {
+  const now = snapshot.now;
+  const matches = snapshot.clientsByKey[entry.key] ?? [];
+  const existing = matches.length === 1 ? matches[0] : null;
+
+  const ownerEmail =
+    options.initialOwner === "admin" ? data.group.adminEmail : snapshot.actor?.email ?? null;
+  const workspaceInput: ClientCreateInput | null = ownerEmail
+    ? { ...entry.client, ownerEmail }
+    : null;
+
+  // ── Workspace
+  const workspace: WorkspacePlanItem = {
+    kind: "workspace",
+    name: entry.workspaceName,
+    initialOwner: options.initialOwner,
+    input: workspaceInput,
+    status: "CREATE",
+    reason: `New workspace; initial owner: ${options.initialOwner === "admin" ? "the group admin" : "the actor"} (app createClient).`,
+  };
+  let workspaceUsable = false;
+  let workspaceBlockedReason = "";
+
+  if (matches.length > 1) {
+    workspace.status = "CONFLICT";
+    workspace.reason = `${matches.length} workspaces already use this name (case-insensitive).`;
+    workspace.unblock = "Use another workspaceName in the data file, or clean up the duplicates in Clients.";
+  } else if (existing) {
+    workspace.existingId = existing.id;
+    if (!existing.ownedByAdmin && !existing.ownedByActor) {
+      workspace.status = "CONFLICT";
+      workspace.reason = snapshot.actor
+        ? "A workspace with this name exists, but neither the group admin nor the actor is an active owner of it."
+        : "A workspace with this name exists, but the group admin is not an active owner of it (pass --actor-email to also check the actor).";
+      workspace.unblock = "Another tenant may own it: use another workspaceName. Never adopt it.";
+    } else if (existing.status === "paused" || existing.status === "archived") {
+      workspace.status = "SKIP";
+      workspace.reason = `Already exists, but its status is ${existing.status}.`;
+      workspaceBlockedReason = `The workspace is ${existing.status}; the app refuses new brands there.`;
+    } else {
+      workspace.status = "SKIP";
+      workspace.reason = "Already exists and is owned by the group admin or the actor.";
+      workspaceUsable = true;
+    }
+  } else if (entry.workspaceEmail && snapshot.workspaceEmailTakenByKey[entry.key]) {
+    workspace.status = "CONFLICT";
+    workspace.reason = "The workspaceEmail is already used by another workspace (often someone's personal workspace).";
+    workspace.unblock = "Set workspaceEmail to null or to an unused address.";
+  } else if (snapshot.assignedAdminFound === false) {
+    workspace.status = "BLOCKED";
+    workspace.reason = "group.assignedPlatformAdminEmail is not an active Platform Owner or Platform Admin.";
+    workspace.unblock = "Fix assignedPlatformAdminEmail or set it to null.";
+  } else if (options.initialOwner === "admin" && !snapshot.admin) {
+    workspace.status = "BLOCKED";
+    workspace.reason = "The group admin has no active TAKATAK account yet, and the app's createClient needs one for the initial owner.";
+    workspace.unblock = "The group admin signs in once (or accepts one invitation), then re-run.";
+  } else if (options.initialOwner === "actor" && !snapshot.actor) {
+    workspace.status = "BLOCKED";
+    workspace.reason = "--initial-owner actor needs --actor-email.";
+    workspace.unblock = "Pass --actor-email.";
+  } else {
+    workspaceUsable = true;
+  }
+
+  const newWorkspace = workspace.status === "CREATE";
+  const gates =
+    existing && workspace.status !== "CONFLICT"
+      ? evaluateGates(
+          existing.subscription,
+          existing.brands.filter((brand) => BILLABLE_BRAND_STATUSES.includes(brand.status)).length,
+          now,
+          false,
+        )
+      : evaluateGates(null, 0, now, true);
+
+  const waitsForWorkspace =
+    workspace.status === "CONFLICT"
+      ? "Waits for the workspace (conflict)."
+      : workspace.status === "BLOCKED"
+        ? "Waits for the workspace (blocked)."
+        : workspaceBlockedReason;
+  // A new workspace that cannot be created yet will still meet the plan
+  // gates once it exists: report both, so the cost overview is complete.
+  const blockedNewWorkspace = workspace.status === "BLOCKED" && !existing;
+
+  // ── Brand
+  const brand: BrandPlanItem = {
+    kind: "brand",
+    name: entry.brand.name,
+    input: entry.brand,
+    status: "CREATE",
+    reason: "New brand (app createBrand).",
+  };
+  let existingBrand: ExistingClientSnapshot["brands"][number] | null = null;
+
+  if (!workspaceUsable) {
+    brand.status = "BLOCKED";
+    brand.reason = waitsForWorkspace;
+    if (workspaceBlockedReason) brand.unblock = "Set the workspace back to active in Clients.";
+    if (blockedNewWorkspace && !gates.canAddBrand) {
+      brand.gate = "brand";
+      brand.reason = `${waitsForWorkspace} After that: ${brandGateReason(gates)}`;
+      brand.unblock = BRAND_UNBLOCK_HINT;
+    }
+  } else {
+    const brandMatches = existing
+      ? existing.brands.filter((row) => row.name.toLowerCase() === entry.brand.name.toLowerCase())
+      : [];
+    if (brandMatches.length > 1) {
+      brand.status = "CONFLICT";
+      brand.reason = `${brandMatches.length} brands in this workspace already use this name.`;
+      brand.unblock = "Clean up the duplicate brands in the workspace.";
+    } else if (brandMatches.length === 1) {
+      existingBrand = brandMatches[0];
+      brand.status = "SKIP";
+      brand.existingId = existingBrand.id;
+      brand.reason = `Already exists (status ${existingBrand.status}).`;
+    } else if (!gates.canAddBrand) {
+      brand.status = "BLOCKED";
+      brand.gate = "brand";
+      brand.reason = brandGateReason(gates);
+      brand.unblock =
+        gates.brandAllowance === 0
+          ? BRAND_UNBLOCK_HINT
+          : "Upgrade this workspace to a plan with more brands, or freeze a brand.";
+    }
+  }
+
+  // ── Locations
+  const brandFrozen =
+    existingBrand && (existingBrand.status === "frozen" || existingBrand.status === "archived");
+  const existingLocations =
+    existing && existingBrand ? existing.locationsByBrandId[existingBrand.id] ?? [] : [];
+
+  const locations: LocationPlanItem[] = [...entry.locations]
+    .sort((a, b) => Number(b.isPrimary) - Number(a.isPrimary))
+    .map((location) => {
+      const item: LocationPlanItem = {
+        kind: "location",
+        name: location.name,
+        isPrimary: location.isPrimary,
+        address: formatAddress(location.input),
+        input: location.input,
+        status: "CREATE",
+        reason: "New location (app createLocation).",
+      };
+      if (brand.status === "BLOCKED" || brand.status === "CONFLICT") {
+        item.status = "BLOCKED";
+        item.reason = `Waits for the brand (${brand.status.toLowerCase()}).`;
+        if (brand.gate) {
+          item.gate = brand.gate;
+          item.unblock = brand.unblock;
+        }
+        return item;
+      }
+      if (brand.status === "CREATE") {
+        return item;
+      }
+      const byAddress = existingLocations.find((row) => isSameAddress(row, location.input));
+      if (byAddress) {
+        item.status = "SKIP";
+        item.existingId = byAddress.id;
+        item.reason =
+          byAddress.name.toLowerCase() === location.name.toLowerCase()
+            ? `Already exists (status ${byAddress.status}).`
+            : `Already exists at this address as "${byAddress.name}" (status ${byAddress.status}).`;
+        return item;
+      }
+      const byName = existingLocations.find(
+        (row) => row.name.toLowerCase() === location.name.toLowerCase(),
+      );
+      if (byName) {
+        item.status = "CONFLICT";
+        item.existingId = byName.id;
+        item.reason = "A location with this name exists at a different address.";
+        item.unblock = "Give the location another name in the data file, or fix the address in the app.";
+        return item;
+      }
+      if (brandFrozen) {
+        item.status = "BLOCKED";
+        item.reason = `The brand is ${existingBrand?.status}; the app's createLocation refuses it.`;
+        item.unblock = "Restore the brand (plan allowance) first.";
+      }
+      return item;
+    });
+
+  // ── Invitations
+  // The admin needs an invitation when it will not be a member otherwise:
+  // --initial-owner actor on a new workspace, or an existing workspace where
+  // the admin is not a member yet.
+  const adminIsMember = existing
+    ? Boolean(existing.membersByEmail[normalizeEmail(data.group.adminEmail)])
+    : options.initialOwner === "admin";
+  const inviteAdmin = !adminIsMember;
+
+  const livePendingElsewhere = (email: string, clientId: string | null) =>
+    snapshot.livePendingInvitations.some(
+      (row) => sameEmail(row.email, email) && row.clientId !== clientId,
+    );
+
+  const invitations: InvitationPlanItem[] = inviteesFor(entry, data, inviteAdmin).map(
+    (invitee) => {
+      const email = invitee.email;
+      const item: InvitationPlanItem = {
+        kind: "invitation",
+        email,
+        role: "owner",
+        purpose: invitee.purpose,
+        status: options.sendInvites ? "SEND" : "PLANNED",
+        reason: options.sendInvites
+          ? "Owner invitation will be sent (Supabase invite or magic link)."
+          : "Owner invitation is ready; nothing is created or sent without --apply --send-invites.",
+      };
+
+      if (!workspaceUsable) {
+        item.status = "BLOCKED";
+        item.reason = waitsForWorkspace;
+        if (blockedNewWorkspace && !gates.canInviteTeam) {
+          item.gate = "team";
+          item.reason = `${waitsForWorkspace} After that: ${gates.inviteMessage ?? "team invitations are not allowed."}`;
+          item.unblock = TEAM_UNBLOCK_HINT;
+        }
+        return item;
+      }
+      if (sameEmail(email, snapshot.actor?.email)) {
+        item.status = "SKIP";
+        item.reason = "This is the actor's own email; the app refuses self-invitations.";
+        return item;
+      }
+      const initialOwnerEmail = workspaceInput?.ownerEmail ?? null;
+      if (newWorkspace && sameEmail(email, initialOwnerEmail)) {
+        item.status = "SKIP";
+        item.reason = "Becomes the initial owner when the workspace is created.";
+        return item;
+      }
+      const member = existing?.membersByEmail[normalizeEmail(email)];
+      if (member) {
+        item.status = "SKIP";
+        item.reason = `Already a member (role ${member.role}, ${member.status}).`;
+        if (member.role !== "owner" || member.status !== "active") {
+          item.unblock = "The script never changes roles: make this member an active owner on the workspace's Team page if needed.";
+        }
+        return item;
+      }
+      const previous = existing?.invitationsByEmail[normalizeEmail(email)];
+      if (previous) {
+        const expiresAt = new Date(previous.expiresAt);
+        const live = previous.status === "pending" && expiresAt.getTime() > now.getTime();
+        if (previous.status === "accepted") {
+          item.status = "SKIP";
+          item.existingId = previous.id;
+          item.reason = "An earlier invitation was accepted (the membership may have been removed since).";
+          return item;
+        }
+        if (live) {
+          item.status = "SKIP";
+          item.existingId = previous.id;
+          item.reason = `A pending invitation already exists (expires ${expiresAt.toISOString().slice(0, 10)}).`;
+          return item;
+        }
+        if (!options.reinviteExpired) {
+          item.status = "BLOCKED";
+          item.existingId = previous.id;
+          item.reason = `The earlier invitation is ${previous.status === "pending" ? "expired" : previous.status}.`;
+          item.unblock = "Re-run with --reinvite-expired to send a new one.";
+          return item;
+        }
+      }
+      if (!gates.canInviteTeam) {
+        item.status = "BLOCKED";
+        item.gate = "team";
+        item.reason = `${gates.inviteMessage ?? "Team invitations are not allowed."} (assertClientCanInviteTeam)`;
+        item.unblock = TEAM_UNBLOCK_HINT;
+        return item;
+      }
+      const normalized = normalizeEmail(email);
+      if (run.plannedEmails.has(normalized) || livePendingElsewhere(email, existing?.id ?? null)) {
+        item.status = "DEFERRED";
+        item.reason =
+          "One live invitation per email: this person already has a pending invitation in another workspace (or one earlier in this run). A new invite or magic link replaces the previous email link.";
+        item.unblock = "Re-run after that invitation is accepted or expires.";
+        return item;
+      }
+      if (run.plannedCount >= options.maxInvites) {
+        item.status = "DEFERRED";
+        item.reason = `--max-invites (${options.maxInvites}) reached for this run.`;
+        item.unblock = "Re-run later (Supabase email rate limits).";
+        return item;
+      }
+      run.plannedEmails.add(normalized);
+      run.plannedCount += 1;
+      return item;
+    },
+  );
+
+  return {
+    key: entry.key,
+    workspace,
+    brand,
+    locations,
+    hours: hoursItem(entry),
+    invitations,
+    gates,
+  };
+}
+
+function itemsOf(plan: WorkspacePlan): BasePlanItem[] {
+  return [
+    plan.workspace,
+    plan.brand,
+    ...plan.locations,
+    ...(plan.hours ? [plan.hours] : []),
+    ...plan.invitations,
+  ];
+}
+
+export function countStatuses(workspaces: WorkspacePlan[]): Record<PlanStatus, number> {
+  const counts = Object.fromEntries(PLAN_STATUSES.map((status) => [status, 0])) as Record<
+    PlanStatus,
+    number
+  >;
+  for (const workspace of workspaces) {
+    for (const item of itemsOf(workspace)) {
+      counts[item.status] += 1;
+    }
+  }
+  return counts;
+}
+
+function blockedByPlanRows(workspaces: WorkspacePlan[]): BlockedByPlanRow[] {
+  const rows: BlockedByPlanRow[] = [];
+  for (const plan of workspaces) {
+    const brandBlocked = plan.brand.gate === "brand";
+    const teamBlocked = plan.invitations.some((item) => item.gate === "team");
+    if (!brandBlocked && !teamBlocked) continue;
+    const needs: BlockedByPlanRow["needs"] =
+      brandBlocked && teamBlocked ? "brand_and_team" : brandBlocked ? "brand" : "team";
+    rows.push({
+      key: plan.key,
+      workspaceName: plan.workspace.name,
+      current: plan.gates.newWorkspace
+        ? "new workspace, no Social subscription"
+        : `${plan.gates.statusLabel}${plan.gates.planCode ? `, ${plan.gates.planCode}` : ""}`,
+      needs,
+      cheapestPlan: teamBlocked ? cadMonthly("social_advanced_15") : cadMonthly("social_essential_1"),
+    });
+  }
+  return rows;
+}
+
+/**
+ * Builds the plan. With snapshot === null (no database) every database-backed
+ * item is UNCHECKED. Workspaces are planned in data order, which also decides
+ * which workspace gets the single live invitation of a shared email.
+ */
+export function buildProvisioningPlan(
+  data: ProvisioningData,
+  snapshot: ProvisioningSnapshot | null,
+  options: PlanOptions,
+): ProvisioningPlan {
+  const run: RunState = { plannedEmails: new Set(), plannedCount: 0 };
+  const workspaces = data.brands.map((entry) =>
+    snapshot
+      ? planWorkspace(entry, data, snapshot, options, run)
+      : offlineWorkspacePlan(entry, data, options),
+  );
+  const counts = countStatuses(workspaces);
+  return {
+    mode: snapshot ? "database" : "offline",
+    workspaces,
+    counts,
+    blockedByPlan: blockedByPlanRows(workspaces),
+    conflicts: counts.CONFLICT,
+  };
+}
+
+/** Restricts the data to the given keys (in data order). Unknown keys are returned. */
+export function selectBrands(
+  data: ProvisioningData,
+  keys: string[] | null,
+): { data: ProvisioningData; unknownKeys: string[] } {
+  if (!keys || keys.length === 0) {
+    return { data, unknownKeys: [] };
+  }
+  const known = new Set(data.brands.map((entry) => entry.key));
+  const wanted = new Set(keys);
+  return {
+    data: { ...data, brands: data.brands.filter((entry) => wanted.has(entry.key)) },
+    unknownKeys: keys.filter((key) => !known.has(key)),
+  };
+}
diff --git a/src/lib/provisioning/workspace-provisioning-runner.ts b/src/lib/provisioning/workspace-provisioning-runner.ts
new file mode 100644
index 0000000..99cc9bf
--- /dev/null
+++ b/src/lib/provisioning/workspace-provisioning-runner.ts
@@ -0,0 +1,760 @@
+/**
+ * Database side of `scripts/provision-workspaces.ts`.
+ *
+ * - loadProvisioningSnapshot: read-only queries that feed the pure plan.
+ * - applyProvisioningPlan: writes ONLY through the app's own services
+ *   (createClient, createBrand, createLocation), which keep their own
+ *   validation, duplicate checks, plan gates and AuditLog rows.
+ * - sendWorkspaceInvitation: the invitation route
+ *   (src/app/api/team/invitations/route.ts) cannot run outside a Next.js
+ *   request (cookies(), NextRequest). This mirrors its steps after the
+ *   authorization check: plan gate, member check, token, 7-day expiry,
+ *   upsert, Supabase invite or magic link, revoke + audit on failure,
+ *   audit on success. The caller is a Platform Owner/Admin instead of a
+ *   workspace owner (documented substitution).
+ *
+ * Nothing here prints. Tokens, token hashes and links never leave this file.
+ */
+
+import "server-only";
+
+import { assertClientCanInviteTeam } from "@/lib/billing/social/entitlement-gates";
+import { createBrand } from "@/lib/brands/brand-service";
+import { createClient } from "@/lib/clients/client-service";
+import { getPrisma } from "@/lib/db/prisma";
+import { createLocation } from "@/lib/locations/location-service";
+import { isServiceError, ServiceError } from "@/lib/services/service-error";
+import { generateInvitationToken } from "@/lib/team/invitation-token";
+import { normalizeEmail } from "@/lib/auth/registration-validation";
+import type {
+  ExistingClientSnapshot,
+  ProvisioningData,
+  ProvisioningPlan,
+  ProvisioningSnapshot,
+  WorkspacePlan,
+} from "@/lib/provisioning/workspace-provisioning-policy";
+
+/** Same value as the invitation route. */
+export const INVITATION_LIFETIME_DAYS = 7;
+
+export const PROVISIONING_SOURCE = "scripts/provision-workspaces.ts";
+
+type Prisma = NonNullable<ReturnType<typeof getPrisma>>;
+
+function requirePrisma(): Prisma {
+  const prisma = getPrisma();
+  if (!prisma) {
+    throw new ServiceError("unavailable", "DATABASE_URL is not configured.");
+  }
+  return prisma;
+}
+
+function insensitive(email: string) {
+  return { equals: email, mode: "insensitive" as const };
+}
+
+// ── Profiles ─────────────────────────────────────────────────
+
+export type ActorCheck =
+  | { ok: true; profileId: string; email: string; role: "owner" | "admin" }
+  | { ok: false; message: string };
+
+/** Mirrors requirePlatformAdminApiAccess: an active Platform Owner or Admin. */
+export async function resolveActor(email: string): Promise<ActorCheck> {
+  const prisma = requirePrisma();
+  const profile = await prisma.profile.findFirst({
+    where: { email: insensitive(email) },
+    select: { id: true, email: true, role: true, status: true },
+  });
+  if (!profile || !profile.email) {
+    return { ok: false, message: "No TAKATAK profile has the --actor-email address." };
+  }
+  if (profile.status !== "active") {
+    return { ok: false, message: `The actor's profile is ${profile.status}, not active.` };
+  }
+  if (profile.role !== "owner" && profile.role !== "admin") {
+    return { ok: false, message: "The actor must be a Platform Owner or Platform Admin." };
+  }
+  return { ok: true, profileId: profile.id, email: normalizeEmail(profile.email), role: profile.role };
+}
+
+// ── Snapshot ─────────────────────────────────────────────────
+
+export async function loadProvisioningSnapshot(
+  data: ProvisioningData,
+  actor: { profileId: string; email: string } | null,
+  now = new Date(),
+): Promise<ProvisioningSnapshot> {
+  const prisma = requirePrisma();
+  const adminEmail = data.group.adminEmail;
+
+  const adminProfile = await prisma.profile.findFirst({
+    where: { email: insensitive(adminEmail), status: "active" },
+    select: { id: true, email: true },
+  });
+  const admin = adminProfile
+    ? { profileId: adminProfile.id, email: normalizeEmail(adminProfile.email ?? adminEmail) }
+    : null;
+
+  let assignedAdminFound: boolean | null = null;
+  if (data.group.assignedPlatformAdminEmail) {
+    const assigned = await prisma.profile.findFirst({
+      where: {
+        email: insensitive(data.group.assignedPlatformAdminEmail),
+        status: "active",
+        role: { in: ["owner", "admin"] },
+      },
+      select: { id: true },
+    });
+    assignedAdminFound = Boolean(assigned);
+  }
+
+  const inviteeEmails = [
+    ...new Set(
+      [adminEmail, ...data.brands.map((entry) => entry.ownerEmail)]
+        .filter((email): email is string => Boolean(email))
+        .map(normalizeEmail),
+    ),
+  ];
+
+  const livePending = await prisma.userInvitation.findMany({
+    where: {
+      OR: inviteeEmails.map((email) => ({ email: insensitive(email) })),
+      status: "pending",
+      expiresAt: { gt: now },
+    },
+    select: { clientId: true, email: true },
+  });
+
+  const ownerProfileIds = [admin?.profileId, actor?.profileId].filter(
+    (id): id is string => Boolean(id),
+  );
+
+  const clientsByKey: ProvisioningSnapshot["clientsByKey"] = {};
+  const workspaceEmailTakenByKey: ProvisioningSnapshot["workspaceEmailTakenByKey"] = {};
+
+  for (const entry of data.brands) {
+    const matches = await prisma.client.findMany({
+      where: { name: { equals: entry.workspaceName, mode: "insensitive" } },
+      select: { id: true, name: true, status: true },
+      orderBy: { createdAt: "asc" },
+      take: 10,
+    });
+
+    const snapshots: ExistingClientSnapshot[] = [];
+    for (const match of matches) {
+      const owners = ownerProfileIds.length
+        ? await prisma.clientMembership.findMany({
+            where: {
+              clientId: match.id,
+              profileId: { in: ownerProfileIds },
+              role: "owner",
+              status: "active",
+            },
+            select: { profileId: true },
+          })
+        : [];
+      const client: ExistingClientSnapshot = {
+        id: match.id,
+        name: match.name,
+        status: match.status,
+        ownedByAdmin: owners.some((row) => row.profileId === admin?.profileId),
+        ownedByActor: owners.some((row) => row.profileId === actor?.profileId),
+        subscription: null,
+        brands: [],
+        locationsByBrandId: {},
+        membersByEmail: {},
+        invitationsByEmail: {},
+      };
+
+      if (matches.length === 1) {
+        await loadClientDetails(prisma, client, entry.brand.name, [
+          adminEmail,
+          ...(entry.ownerEmail ? [entry.ownerEmail] : []),
+        ]);
+      }
+      snapshots.push(client);
+    }
+    clientsByKey[entry.key] = snapshots;
+
+    if (entry.workspaceEmail) {
+      const taken = await prisma.client.findFirst({
+        where: {
+          email: insensitive(entry.workspaceEmail),
+          id: { notIn: matches.map((match) => match.id) },
+        },
+        select: { id: true },
+      });
+      workspaceEmailTakenByKey[entry.key] = Boolean(taken);
+    }
+  }
+
+  return {
+    now,
+    actor,
+    admin,
+    assignedAdminFound,
+    clientsByKey,
+    workspaceEmailTakenByKey,
+    livePendingInvitations: livePending.map((row) => ({
+      clientId: row.clientId,
+      email: normalizeEmail(row.email),
+    })),
+  };
+}
+
+async function loadClientDetails(
+  prisma: Prisma,
+  client: ExistingClientSnapshot,
+  brandName: string,
+  emails: string[],
+): Promise<void> {
+  const [subscription, brands] = await Promise.all([
+    prisma.clientSubscription.findUnique({
+      where: { clientId: client.id },
+      select: {
+        status: true,
+        planCode: true,
+        cancelAtPeriodEnd: true,
+        currentPeriodEnd: true,
+        xAccountAllowance: true,
+        advancedAnalytics: true,
+      },
+    }),
+    prisma.businessBrand.findMany({
+      where: { clientId: client.id },
+      select: { id: true, name: true, status: true },
+      orderBy: { createdAt: "asc" },
+    }),
+  ]);
+  client.subscription = subscription;
+  client.brands = brands;
+
+  const matchingBrandIds = brands
+    .filter((brand) => brand.name.toLowerCase() === brandName.toLowerCase())
+    .map((brand) => brand.id);
+  if (matchingBrandIds.length > 0) {
+    const locations = await prisma.businessLocation.findMany({
+      where: { clientId: client.id, businessBrandId: { in: matchingBrandIds } },
+      select: {
+        id: true,
+        businessBrandId: true,
+        name: true,
+        status: true,
+        isPrimary: true,
+        addressLine1: true,
+        addressLine2: true,
+        city: true,
+        postalCode: true,
+      },
+      orderBy: { createdAt: "asc" },
+    });
+    for (const { businessBrandId, ...location } of locations) {
+      (client.locationsByBrandId[businessBrandId] ??= []).push(location);
+    }
+  }
+
+  for (const email of [...new Set(emails.map(normalizeEmail))]) {
+    // Same lookup as the invitation route: any membership status counts.
+    const membership = await prisma.clientMembership.findFirst({
+      where: { clientId: client.id, profile: { email: insensitive(email) } },
+      select: { role: true, status: true },
+    });
+    if (membership) {
+      client.membersByEmail[email] = membership;
+    }
+    const invitation = await prisma.userInvitation.findUnique({
+      where: { clientId_email: { clientId: client.id, email } },
+      select: { id: true, status: true, role: true, expiresAt: true },
+    });
+    if (invitation) {
+      client.invitationsByEmail[email] = invitation;
+    }
+  }
+}
+
+// ── Invitations (mirror of the route) ────────────────────────
+
+type AuthErrorLike = { message: string; code?: unknown } | null;
+
+/** The two Supabase Auth calls the route uses. `supabase.auth` satisfies it. */
+export type InvitationAuthClient = {
+  admin: {
+    inviteUserByEmail(
+      email: string,
+      options: { redirectTo: string; data: Record<string, unknown> },
+    ): Promise<{ error: AuthErrorLike }>;
+  };
+  signInWithOtp(credentials: {
+    email: string;
+    options: { shouldCreateUser: boolean; emailRedirectTo: string };
+  }): Promise<{ error: AuthErrorLike }>;
+};
+
+export type InvitationSender = {
+  /** Public https origin of the app (NEXT_PUBLIC_APP_URL). */
+  origin: string;
+  auth: InvitationAuthClient;
+};
+
+export type InvitationOutcome =
+  | { outcome: "sent"; invitationId: string; deliveryMethod: "invite" | "magiclink" }
+  | {
+      outcome: "failed";
+      invitationId: string;
+      deliveryMethod: "invite" | "magiclink";
+      message: string;
+    }
+  | { outcome: "skipped"; message: string };
+
+function errorCodeOf(error: NonNullable<AuthErrorLike>): string | null {
+  return typeof error === "object" &&
+    error !== null &&
+    "code" in error &&
+    typeof error.code === "string"
+    ? error.code
+    : null;
+}
+
+export async function sendWorkspaceInvitation(input: {
+  clientId: string;
+  email: string;
+  role: "owner";
+  actorProfileId: string;
+  sender: InvitationSender;
+  now?: Date;
+}): Promise<InvitationOutcome> {
+  const prisma = requirePrisma();
+  const email = normalizeEmail(input.email);
+  const now = input.now ?? new Date();
+
+  // Route line ~100: the plan gate, checked again right before writing.
+  await assertClientCanInviteTeam(input.clientId);
+
+  const [workspace, inviter] = await Promise.all([
+    prisma.client.findUnique({
+      where: { id: input.clientId },
+      select: { id: true, name: true },
+    }),
+    prisma.profile.findUnique({
+      where: { id: input.actorProfileId },
+      select: { id: true, email: true },
+    }),
+  ]);
+  if (!workspace || !inviter) {
+    throw new ServiceError("not_found", "The workspace or inviting user could not be found.");
+  }
+  if (inviter.email?.toLowerCase() === email) {
+    return { outcome: "skipped", message: "Self-invitation refused (same rule as the app)." };
+  }
+
+  const existingMembership = await prisma.clientMembership.findFirst({
+    where: { clientId: input.clientId, profile: { email: insensitive(email) } },
+    select: { id: true },
+  });
+  if (existingMembership) {
+    return { outcome: "skipped", message: "Already a workspace member." };
+  }
+
+  // Idempotency guard (stricter than the route, which always rotates the
+  // token): never replace a live pending or an accepted invitation.
+  const previous = await prisma.userInvitation.findUnique({
+    where: { clientId_email: { clientId: input.clientId, email } },
+    select: { status: true, expiresAt: true },
+  });
+  if (
+    previous &&
+    (previous.status === "accepted" ||
+      (previous.status === "pending" && previous.expiresAt.getTime() > now.getTime()))
+  ) {
+    return { outcome: "skipped", message: `An invitation is already ${previous.status}.` };
+  }
+
+  const { token, tokenHash } = generateInvitationToken();
+  const expiresAt = new Date(now.getTime() + INVITATION_LIFETIME_DAYS * 24 * 60 * 60 * 1000);
+
+  const invitation = await prisma.userInvitation.upsert({
+    where: { clientId_email: { clientId: input.clientId, email } },
+    create: {
+      clientId: input.clientId,
+      email,
+      role: input.role,
+      status: "pending",
+      tokenHash,
+      customPermissions: [],
+      deniedPermissions: [],
+      invitedByProfileId: input.actorProfileId,
+      expiresAt,
+    },
+    update: {
+      role: input.role,
+      status: "pending",
+      tokenHash,
+      customPermissions: [],
+      deniedPermissions: [],
+      invitedByProfileId: input.actorProfileId,
+      expiresAt,
+      acceptedAt: null,
+      revokedAt: null,
+    },
+    select: { id: true },
+  });
+
+  const callbackUrl = new URL(
+    `/auth/callback/invite/${encodeURIComponent(token)}`,
+    input.sender.origin,
+  );
+  callbackUrl.searchParams.set("flow", "invite");
+
+  let deliveryMethod: "invite" | "magiclink" = "invite";
+  let deliveryError: AuthErrorLike = null;
+
+  const { error: invitationError } = await input.sender.auth.admin.inviteUserByEmail(email, {
+    redirectTo: callbackUrl.toString(),
+    data: { invited_workspace_name: workspace.name },
+  });
+
+  if (invitationError) {
+    const errorCode = errorCodeOf(invitationError);
+    const emailAlreadyExists =
+      errorCode === "email_exists" ||
+      errorCode === "user_already_exists" ||
+      invitationError.message.toLowerCase().includes("already been registered");
+
+    if (emailAlreadyExists) {
+      deliveryMethod = "magiclink";
+      const { error: magicLinkError } = await input.sender.auth.signInWithOtp({
+        email,
+        options: { shouldCreateUser: false, emailRedirectTo: callbackUrl.toString() },
+      });
+      deliveryError = magicLinkError;
+    } else {
+      deliveryError = invitationError;
+    }
+  }
+
+  if (deliveryError) {
+    await prisma.userInvitation.update({
+      where: { id: invitation.id },
+      data: { status: "revoked", revokedAt: new Date() },
+    });
+    await prisma.auditLog.create({
+      data: {
+        profileId: input.actorProfileId,
+        clientId: input.clientId,
+        action: "user_invitation_failed",
+        entityType: "UserInvitation",
+        entityId: invitation.id,
+        metadata: {
+          note: `Invitation delivery failed for ${email}.`,
+          deliveryMethod,
+          source: PROVISIONING_SOURCE,
+        },
+      },
+    });
+    return {
+      outcome: "failed",
+      invitationId: invitation.id,
+      deliveryMethod,
+      message: deliveryError.message,
+    };
+  }
+
+  await prisma.auditLog.create({
+    data: {
+      profileId: input.actorProfileId,
+      clientId: input.clientId,
+      action: "user_invitation_sent",
+      entityType: "UserInvitation",
+      entityId: invitation.id,
+      metadata: {
+        note: `${email} was invited to ${workspace.name} as ${input.role}.`,
+        deliveryMethod,
+        source: PROVISIONING_SOURCE,
+      },
+    },
+  });
+
+  return { outcome: "sent", invitationId: invitation.id, deliveryMethod };
+}
+
+// ── Apply ────────────────────────────────────────────────────
+
+export type AppliedItem = {
+  kind: "workspace" | "brand" | "location" | "invitation";
+  name: string;
+  id: string | null;
+  outcome: "created" | "sent" | "skipped" | "blocked" | "failed";
+  message?: string;
+};
+
+export type WorkspaceApplyResult = {
+  key: string;
+  workspaceName: string;
+  clientId: string | null;
+  brandId: string | null;
+  items: AppliedItem[];
+  errors: string[];
+  verified: boolean;
+};
+
+export type ApplyOptions = {
+  actorProfileId: string;
+  /** Required when the plan contains SEND items. */
+  sender: InvitationSender | null;
+  inviteDelayMs: number;
+  sleep?: (milliseconds: number) => Promise<void>;
+  onProgress?: (message: string) => void;
+};
+
+const defaultSleep = (milliseconds: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, milliseconds));
+
+function describeError(error: unknown): string {
+  if (isServiceError(error)) {
+    const fields = Object.values(error.fieldErrors ?? {});
+    return `${error.code}: ${error.message}${fields.length ? ` (${fields.join(" ")})` : ""}`;
+  }
+  return `unexpected: ${error instanceof Error ? error.message : "unknown error"}`;
+}
+
+function isConcurrentLocationConflict(error: unknown): boolean {
+  return (
+    isServiceError(error) &&
+    error.code === "conflict" &&
+    error.message.startsWith("Another location change happened at the same time")
+  );
+}
+
+async function createLocationWithRetry(
+  clientId: string,
+  actorProfileId: string,
+  input: Parameters<typeof createLocation>[2],
+) {
+  try {
+    return await createLocation(clientId, actorProfileId, input);
+  } catch (error) {
+    if (!isConcurrentLocationConflict(error)) throw error;
+    return createLocation(clientId, actorProfileId, input);
+  }
+}
+
+/**
+ * Applies the plan one workspace at a time, in data order. A failure stops
+ * only that workspace's remaining steps. Each workspace is read back after.
+ */
+export async function applyProvisioningPlan(
+  plan: ProvisioningPlan,
+  options: ApplyOptions,
+): Promise<WorkspaceApplyResult[]> {
+  const prisma = requirePrisma();
+  const sleep = options.sleep ?? defaultSleep;
+  const results: WorkspaceApplyResult[] = [];
+  let sentInThisRun = 0;
+
+  const hasSends = plan.workspaces.some((workspace) =>
+    workspace.invitations.some((item) => item.status === "SEND"),
+  );
+  if (hasSends && !options.sender) {
+    throw new ServiceError("invalid_input", "The plan sends invitations but no sender is configured.");
+  }
+
+  for (const workspacePlan of plan.workspaces) {
+    const result: WorkspaceApplyResult = {
+      key: workspacePlan.key,
+      workspaceName: workspacePlan.workspace.name,
+      clientId: workspacePlan.workspace.existingId ?? null,
+      brandId: workspacePlan.brand.existingId ?? null,
+      items: [],
+      errors: [],
+      verified: false,
+    };
+    results.push(result);
+
+    const workspaceStatus = workspacePlan.workspace.status;
+    if (workspaceStatus !== "CREATE" && workspaceStatus !== "SKIP") {
+      continue;
+    }
+    options.onProgress?.(`${workspacePlan.workspace.name}: applying`);
+
+    try {
+      // Workspace
+      if (workspaceStatus === "CREATE") {
+        if (!workspacePlan.workspace.input) {
+          throw new ServiceError("invalid_input", "The workspace has no initial owner.");
+        }
+        const client = await createClient(workspacePlan.workspace.input, options.actorProfileId);
+        result.clientId = client.id;
+        result.items.push({ kind: "workspace", name: client.name, id: client.id, outcome: "created" });
+      }
+      const clientId = result.clientId;
+      if (!clientId) {
+        throw new ServiceError("not_found", "The workspace id is missing.");
+      }
+
+      // Brand
+      if (workspacePlan.brand.status === "CREATE") {
+        const brand = await createBrand(clientId, options.actorProfileId, workspacePlan.brand.input);
+        result.brandId = brand.id;
+        result.items.push({ kind: "brand", name: brand.name, id: brand.id, outcome: "created" });
+      }
+
+      // Locations (primary first; the plan is already sorted)
+      if (result.brandId) {
+        for (const location of workspacePlan.locations) {
+          if (location.status !== "CREATE") continue;
+          const created = await createLocationWithRetry(clientId, options.actorProfileId, {
+            ...location.input,
+            businessBrandId: result.brandId,
+          });
+          result.items.push({
+            kind: "location",
+            name: created.name,
+            id: created.id,
+            outcome: "created",
+          });
+        }
+      }
+
+      // Invitations (only SEND items exist with --send-invites)
+      for (const invitation of workspacePlan.invitations) {
+        if (invitation.status !== "SEND" || !options.sender) continue;
+        if (sentInThisRun > 0 && options.inviteDelayMs > 0) {
+          options.onProgress?.(
+            `waiting ${Math.round(options.inviteDelayMs / 1000)}s before the next invitation`,
+          );
+          await sleep(options.inviteDelayMs);
+        }
+        try {
+          const outcome = await sendWorkspaceInvitation({
+            clientId,
+            email: invitation.email,
+            role: invitation.role,
+            actorProfileId: options.actorProfileId,
+            sender: options.sender,
+          });
+          if (outcome.outcome !== "skipped") sentInThisRun += 1;
+          if (outcome.outcome === "sent") {
+            result.items.push({
+              kind: "invitation",
+              name: invitation.email,
+              id: outcome.invitationId,
+              outcome: "sent",
+              message: `delivered as ${outcome.deliveryMethod}`,
+            });
+          } else if (outcome.outcome === "failed") {
+            result.items.push({
+              kind: "invitation",
+              name: invitation.email,
+              id: outcome.invitationId,
+              outcome: "failed",
+              message: `${outcome.deliveryMethod} delivery failed: ${outcome.message}`,
+            });
+            result.errors.push("An invitation could not be delivered (revoked and audited).");
+          } else {
+            result.items.push({
+              kind: "invitation",
+              name: invitation.email,
+              id: null,
+              outcome: "skipped",
+              message: outcome.message,
+            });
+          }
+        } catch (error) {
+          if (isServiceError(error) && error.code === "forbidden") {
+            // The plan gate changed since planning: report, never bypass.
+            result.items.push({
+              kind: "invitation",
+              name: invitation.email,
+              id: null,
+              outcome: "blocked",
+              message: error.message,
+            });
+            continue;
+          }
+          throw error;
+        }
+      }
+    } catch (error) {
+      result.errors.push(describeError(error));
+    }
+
+    if (result.clientId) {
+      await verifyWorkspace(prisma, workspacePlan, result);
+    }
+  }
+
+  return results;
+}
+
+async function verifyWorkspace(
+  prisma: Prisma,
+  workspacePlan: WorkspacePlan,
+  result: WorkspaceApplyResult,
+): Promise<void> {
+  const problems: string[] = [];
+  const clientId = result.clientId as string;
+
+  const client = await prisma.client.findUnique({
+    where: { id: clientId },
+    select: { name: true, status: true },
+  });
+  if (!client) {
+    problems.push("workspace row not found");
+  } else if (client.name.toLowerCase() !== workspacePlan.workspace.name.toLowerCase()) {
+    problems.push("workspace name differs");
+  }
+
+  if (result.items.some((item) => item.kind === "workspace" && item.outcome === "created")) {
+    const ownerEmail = workspacePlan.workspace.input?.ownerEmail ?? "";
+    const [owner, audit] = await Promise.all([
+      prisma.clientMembership.findFirst({
+        where: {
+          clientId,
+          role: "owner",
+          status: "active",
+          profile: { email: insensitive(ownerEmail) },
+        },
+        select: { id: true },
+      }),
+      prisma.auditLog.findFirst({
+        where: { clientId, action: "workspace_created", entityId: clientId },
+        select: { id: true },
+      }),
+    ]);
+    if (!owner) problems.push("initial owner membership not found");
+    if (!audit) problems.push("workspace_created audit row not found");
+  }
+
+  if (result.brandId) {
+    const brand = await prisma.businessBrand.findFirst({
+      where: { id: result.brandId, clientId },
+      select: { id: true },
+    });
+    if (!brand) problems.push("brand row not found");
+  }
+
+  for (const item of result.items) {
+    if (item.kind === "location" && item.outcome === "created" && item.id) {
+      const location = await prisma.businessLocation.findFirst({
+        where: { id: item.id, clientId, businessBrandId: result.brandId ?? undefined },
+        select: { id: true },
+      });
+      if (!location) problems.push(`location ${item.name} not found`);
+    }
+    if (item.kind === "invitation" && item.outcome === "sent" && item.id) {
+      const invitation = await prisma.userInvitation.findUnique({
+        where: { id: item.id },
+        select: { status: true, expiresAt: true },
+      });
+      if (!invitation || invitation.status !== "pending" || invitation.expiresAt <= new Date()) {
+        problems.push("a sent invitation is not pending");
+      }
+    }
+  }
+
+  result.verified = problems.length === 0;
+  for (const problem of problems) {
+    result.errors.push(`read-back: ${problem}`);
+  }
+}
