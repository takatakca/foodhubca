{
  "name": "takatak-accounting-control-tower",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "qa:seed": "node scripts/qa-seed-check.mjs",
    "qa:env": "node scripts/env-check.mjs",
    "connector:readiness": "node scripts/phase25-connector-readiness.mjs",
    "preflight": "node scripts/final-readiness-check.mjs",
    "release:check": "npm run qa:env && npm run connector:readiness && npm run preflight",
    "sync:dry-run": "node scripts/sync-dry-run.mjs",
    "setup": "node scripts/setup-wizard.mjs",
    "verify:foodhub": "node scripts/foodhub-e2e.mjs",
    "demo:foodhub": "node scripts/foodhub-e2e.mjs --demo"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "next": "16.3.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
