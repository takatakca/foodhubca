# Copy to .env (next to these scripts, or in deploy\screens\) and fill it. Never commit .env. Names only here.
# Food Hub address.
FOODHUB_URL=https://foodhub.on2go.ca
# Same value as FOODHUB_SCREENS_AGENT_TOKEN on Food Hub (Coolify). 24+ random characters.
FOODHUB_SCREENS_AGENT_TOKEN=
# How often each agent reports to Food Hub (seconds, default 20).
HEARTBEAT_SECONDS=20
# Screen ids shown in Food Hub > Stores > Platform screens > edit (one per screen; the name is the "id" in screens.json).
SCREEN_ID_UBER_1=
SCREEN_ID_DOORDASH_1=
SCREEN_ID_SKIP_1=
