+export type DatabaseIdentity = {
+  host: string;
+  name: string;
+  /** Supabase project ref from a pooler user name ("postgres.<ref>"), else null. */
+  projectRef: string | null;
+  /** What --confirm-db must equal: "<host>/<ref>" on a shared pooler, else the host. */
+  identity: string;
+};
+
+/**
+ * Names the database a DATABASE_URL points to, without the user's password.
+ * Supabase's pooler host is shared by every project in a region, so on a pooler
+ * the host alone does not say which project would be written: the project ref
+ * from the user name is part of the identity. Returns null for an invalid URL.
+ */
+export function describeDatabaseUrl(url: string): DatabaseIdentity | null {
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    return null;
+  }
+  const host = parsed.hostname.toLowerCase();
+  if (!host) return null;
+  const name = decodeURIComponent(parsed.pathname.replace(/^\//, "")) || "(default)";
+  const user = decodeURIComponent(parsed.username);
+  const projectRef = /^[^.]+\.([a-z0-9]{8,})$/i.exec(user)?.[1]?.toLowerCase() ?? null;
+  return { host, name, projectRef, identity: projectRef ? `${host}/${projectRef}` : host };
+}
+
