@@ -0,0 +1,409 @@
+// Workspace provisioning against a real database (ephemeral CI Postgres or a
+// local throwaway one). Synthetic example.test data only; refuses any
+// non-loopback DATABASE_URL. No Supabase call: invitations go through a fake
+// auth client that records what the route would have sent.
+// Run: npm run qa:provision-workspaces-db
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { disconnectPrisma, getPrisma } from "@/lib/db/prisma";
+import {
+  buildProvisioningPlan,
+  parseProvisioningData,
+  type PlanOptions,
+  type ProvisioningData,
+} from "@/lib/provisioning/workspace-provisioning-policy";
+import {
+  applyProvisioningPlan,
+  loadProvisioningSnapshot,
+  type InvitationAuthClient,
+  type InvitationSender,
+} from "@/lib/provisioning/workspace-provisioning-runner";
+import { hashInvitationToken } from "@/lib/team/invitation-token";
+
+const REPO_ROOT = path.resolve(fileURLToPath(new URL("..", import.meta.url)));
+const host = new URL(process.env.DATABASE_URL ?? "postgresql://invalid").hostname;
+if (host !== "127.0.0.1" && host !== "localhost") {
+  throw new Error("Refusing to run: DATABASE_URL must be loopback.");
+}
+const prisma = getPrisma();
+if (!prisma) {
+  throw new Error("DATABASE_URL is required.");
+}
+const db = prisma;
+
+const run = randomUUID().slice(0, 8);
+const email = (name: string) => `${name}-${run}@example.test`;
+const ORIGIN = "https://app.example.test";
+
+const OPTIONS: PlanOptions = { initialOwner: "admin", sendInvites: false, maxInvites: 10, reinviteExpired: false };
+
+type SentCall = { kind: "invite" | "magiclink"; email: string; redirectTo: string; data?: Record<string, unknown> };
+
+function fakeSender(behaviour: {
+  invite?: (address: string) => { message: string; code?: string } | null;
+  magiclink?: (address: string) => { message: string } | null;
+}): InvitationSender & { calls: SentCall[] } {
+  const calls: SentCall[] = [];
+  const auth: InvitationAuthClient = {
+    admin: {
+      async inviteUserByEmail(address, options) {
+        calls.push({ kind: "invite", email: address, redirectTo: options.redirectTo, data: options.data });
+        return { error: behaviour.invite?.(address) ?? null };
+      },
+    },
+    async signInWithOtp(credentials) {
+      calls.push({ kind: "magiclink", email: credentials.email, redirectTo: credentials.options.emailRedirectTo });
+      return { error: behaviour.magiclink?.(credentials.email) ?? null };
+    },
+  };
+  return { origin: ORIGIN, auth, calls };
+}
+
+async function profile(address: string, role: "user" | "admin" | "owner" = "user") {
+  return db.profile.create({
+    data: { authUserId: randomUUID(), email: address, role, status: "active", displayName: address.split("@")[0] },
+  });
+}
+
+async function counts(clientIds: string[]) {
+  const [clients, brands, locations, invitations, audits, memberships, subscriptions] = await Promise.all([
+    db.client.count({ where: { name: { contains: run } } }),
+    db.businessBrand.count({ where: { clientId: { in: clientIds } } }),
+    db.businessLocation.count({ where: { clientId: { in: clientIds } } }),
+    db.userInvitation.count({ where: { clientId: { in: clientIds } } }),
+    db.auditLog.count({ where: { clientId: { in: clientIds } } }),
+    db.clientMembership.count({ where: { clientId: { in: clientIds } } }),
+    db.clientSubscription.count({ where: { clientId: { in: clientIds } } }),
+  ]);
+  return { clients, brands, locations, invitations, audits, memberships, subscriptions };
+}
+
+function dataFor(adminEmail: string): ProvisioningData {
+  const parsed = parseProvisioningData({
+    version: 1,
+    group: { companyName: `Example Holding ${run}`, adminEmail, assignedPlatformAdminEmail: null },
+    defaults: { city: "Montreal", region: "QC", country: "Canada" },
+    addresses: {
+      one: { addressLine1: "100 Example Avenue", postalCode: "H0H 0H0" },
+      two: { addressLine1: "200 Example Street East", postalCode: "H0H 0H0" },
+    },
+    hours: { late: { mon: [["16:00", "03:00"]], sun: [["16:00", "03:00"]] } },
+    brands: [
+      {
+        key: "alpha",
+        workspaceName: `Alpha ${run}`,
+        brand: { name: `Alpha ${run}` },
+        ownerEmail: email("owner-a"),
+        locations: [{ address: "one" }, { address: "two", isPrimary: true }],
+        hours: "late",
+      },
+      {
+        key: "beta",
+        workspaceName: `Beta ${run}`,
+        brand: { name: `Beta ${run}` },
+        ownerEmail: email("owner-b"),
+        locations: [{ address: "one" }],
+      },
+      {
+        key: "taken",
+        workspaceName: `Taken ${run}`,
+        brand: { name: `Taken ${run}` },
+        ownerEmail: null,
+        locations: [{ address: "one" }],
+      },
+    ],
+  });
+  if (!parsed.ok) throw new Error(parsed.errors.join("\n"));
+  return parsed.data;
+}
+
+function runCli(args: string[], env: Record<string, string | undefined> = {}) {
+  const childEnv: Record<string, string> = {};
+  for (const [key, value] of Object.entries({ ...process.env, ...env })) {
+    if (value !== undefined) childEnv[key] = value;
+  }
+  const result = spawnSync(
+    path.join(REPO_ROOT, "node_modules", ".bin", "tsx"),
+    ["--require", "./scripts/register-server-only.cjs", "scripts/provision-workspaces.ts", ...args],
